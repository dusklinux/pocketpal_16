+        }
+        cache->last_best = best;
+    }
+    const int grid_index = neighbours[best+1];
+    const int8_t * levels = (const int8_t *)(grid + grid_index);
+    for (int i = 0; i < 8; ++i) L[i] = (levels[i] - 1)/2;
+    return grid_index;
+}
