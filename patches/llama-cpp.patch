+    ggml_tensor * norms = ggml_sum_rows(ctx0, ggml_sqr(ctx0, codebook));  // [1, n_entries]
+    norms = ggml_reshape_2d(ctx0, norms, norms->ne[1], 1);                // [n_entries, 1]
+    return ggml_argmax(ctx0, ggml_sub(ctx0, ggml_scale(ctx0, dots, 2.0f), norms));
