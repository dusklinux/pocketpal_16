@@ -0,0 +1,34 @@
+#include "models.h"
+
+ggml_cgraph * mtmd_graph_yue2_gen::build() {
+    const auto & y = model.yue2;
+
+    if (gen_process == MTMD_SUBCTX_GEN_PROCESS_LATENT_IN || gen_process == MTMD_SUBCTX_GEN_PROCESS_LATENT_OUT) {
+        const bool is_in = gen_process == MTMD_SUBCTX_GEN_PROCESS_LATENT_IN;
+        ggml_tensor * w = is_in ? y.inp_w : y.out_w;
+        ggml_tensor * b = is_in ? y.inp_b : y.out_b;
+        ggml_tensor * cur = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, w->ne[0], n_rows);
+        ggml_set_name(cur, "inp_feats");
+        ggml_set_input(cur);
+        cur = ggml_add(ctx0, build_mm(w, cur), b);
+        ggml_set_name(cur, "out_feats");
+        ggml_set_output(cur);
+        ggml_build_forward_expand(gf, cur);
+        return gf;
+    }
+
+    GGML_ASSERT(gen_process == MTMD_SUBCTX_GEN_PROCESS_GEN_WAV);
+
+    ggml_tensor * inp = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_latent, n_rows);
+    ggml_set_name(inp, "inp_feats");
+    ggml_set_input(inp);
+
+    ggml_tensor * x = ggml_cont(ctx0, ggml_transpose(ctx0, inp)); // [T, n_latent]
+    x = build_snake_vae(x, model.snake_vae); // [T, n_channels]
+
+    x = ggml_cont(ctx0, ggml_transpose(ctx0, x)); // interleaved
+    ggml_set_name(x, "out_audio");
+    ggml_set_output(x);
+    ggml_build_forward_expand(gf, x);
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/zonos3-gen.cpp b/vendor/llama.cpp/tools/mtmd/models/zonos3-gen.cpp
new file mode 100644
index 0000000..d306f98
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/zonos3-gen.cpp
@@ -0,0 +1,207 @@
+#include "models.h"
+
+// GEN_CODE: hidden state -> logits of the 10 codebooks (out_feats), or codes -> backbone row (graph output)
+ggml_cgraph * mtmd_graph_zonos3_gen::build_gen_code() {
+    ggml_tensor * embd_w = model.gen_code_out_embd_w; // [n_embd, n_vocab * n_codebooks]
+    const int64_t n_vocab = embd_w->ne[1] / n_codebooks;
+
+    if (!all_known) {
+        ggml_tensor * h = ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_mmproj_embd);
+        ggml_set_name(h, "inp_raw");
+        ggml_set_input(h);
+
+        ggml_tensor * logits = ggml_mul_mat(ctx0, model.gen_code_head_w, h);
+        logits = ggml_scale(ctx0, ggml_tanh(ctx0, ggml_scale(ctx0, logits, 1.0f / softcap)), softcap);
+        logits = ggml_reshape_2d(ctx0, logits, n_vocab, n_codebooks);
+        ggml_set_name(logits, "out_feats");
+        ggml_set_output(logits);
+        ggml_build_forward_expand(gf, logits);
+    }
+
+    ggml_tensor * inp_codes = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_codebooks);
+    ggml_set_name(inp_codes, "inp_codes");
+    ggml_set_input(inp_codes);
+
+    ggml_tensor * embd = ggml_get_rows(ctx0, embd_w, inp_codes); // [n_embd, n_codebooks]
+    embd = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, embd)));
+    embd = ggml_reshape_2d(ctx0, embd, n_mmproj_embd, 1);
+    cb(embd, "gen_embd", -1);
+    ggml_build_forward_expand(gf, embd);
+
+    return gf;
+}
+
+std::vector<c2w_state_slot> list_zonos3_gen_state_slots(const mtmd_hparams & hparams, const mtmd_model & model) {
+    GGML_UNUSED(hparams);
+    const auto & z = model.zonos3;
+    std::vector<c2w_state_slot> slots;
+    slots.push_back({"pos", 1, 1});
+    for (size_t i = 0; i < z.sem.size(); i++) {
+        slots.push_back({"sem_conv_" + std::to_string(i), z.sem[i].dw_w->ne[0] - 1, z.sem[i].dw_w->ne[1]});
+    }
+    for (size_t s = 0; s < z.stages.size(); s++) {
+        const int64_t d = z.stages[s].layers.empty() ? 0 : z.stages[s].layers[0].wo_w->ne[1];
+        for (size_t il = 0; il < z.stages[s].layers.size(); il++) {
+            const std::string sfx = std::to_string(s) + "_" + std::to_string(il);
+            slots.push_back({"tfm_k_" + sfx, d, mtmd_graph_zonos3_gen::stage_ctx[s] - 1});
+            slots.push_back({"tfm_v_" + sfx, d, mtmd_graph_zonos3_gen::stage_ctx[s] - 1});
+        }
+    }
+    for (size_t i = 0; i < z.head.size(); i++) {
+        slots.push_back({"head_conv_" + std::to_string(i), z.head[i].dw_w->ne[0] - 1, z.head[i].dw_w->ne[1]});
+    }
+    return slots;
+}
+
+static ggml_tensor * zonos3_layer_norm(ggml_context * ctx, ggml_tensor * x, ggml_tensor * w, ggml_tensor * b, float eps) {
+    return ggml_add(ctx, ggml_mul(ctx, ggml_norm(ctx, x, eps), w), b);
+}
+
+// causal ConvNeXt block, the conv history is kept in the state
+ggml_tensor * mtmd_graph_zonos3_gen::convnext(ggml_tensor * x, const mtmd_zonos3_wav::convnext & b, const std::string & state_name) {
+    const int64_t C = x->ne[0];
+    const int64_t T = x->ne[1];
+    const int64_t K = b.dw_w->ne[0];
+
+    ggml_tensor * hist = state_in.at(state_name); // [K - 1, C]
+    ggml_tensor * xt   = ggml_concat(ctx0, hist, ggml_cont(ctx0, ggml_transpose(ctx0, x)), 0); // [K - 1 + T, C]
+    state_out.push_back({state_name, ggml_cont(ctx0, ggml_view_2d(ctx0, xt, K - 1, C, xt->nb[1], (size_t) T * xt->nb[0]))});
+
+    ggml_tensor * h = ggml_ssm_conv(ctx0, ggml_reshape_3d(ctx0, xt, K - 1 + T, C, 1), b.dw_w); // [C, T, 1]
+    h = ggml_add(ctx0, ggml_reshape_2d(ctx0, h, C, T), b.dw_b);
+    h = zonos3_layer_norm(ctx0, h, b.norm_w, b.norm_b, convnext_eps);
+    h = ggml_gelu_erf(ctx0, ggml_add(ctx0, ggml_mul_mat(ctx0, b.pw1_w, h), b.pw1_b));
+    h = ggml_add(ctx0, ggml_mul_mat(ctx0, b.pw2_w, h), b.pw2_b);
+    return ggml_add(ctx0, x, h);
+}
+
+// windowed causal MOSS layer, adapted from qwen3tts code2wav tfm_layer_forward()
+ggml_tensor * mtmd_graph_zonos3_gen::moss_layer(ggml_tensor * x, const mtmd_zonos3_wav::layer & l, int s, int il, ggml_tensor * base) {
+    const int64_t d      = x->ne[0];
+    const int64_t N      = x->ne[1];
+    const int64_t n_head = d / head_dim;
+    const int64_t W      = stage_ctx[s];
+    const int64_t prefix = W - 1;
+    const int64_t n_kv   = prefix + N;
+    const std::string sfx = std::to_string(s) + "_" + std::to_string(il);
+
+    ggml_tensor * h   = zonos3_layer_norm(ctx0, x, l.norm1_w, l.norm1_b, ln_eps);
+    ggml_tensor * qkv = ggml_mul_mat(ctx0, l.qkv_w, h); // [3d, N]
+    auto section = [&](int i) {
+        return ggml_cont(ctx0, ggml_view_3d(ctx0, qkv, head_dim, n_head, N, ggml_row_size(qkv->type, head_dim), qkv->nb[1],
+                                            ggml_row_size(qkv->type, i * d)));
+    };
+
+    ggml_tensor * pos = ggml_cast(ctx0, ggml_add(ctx0, ggml_arange(ctx0, 0.0f, (float) N, 1.0f), base), GGML_TYPE_I32);
+    ggml_tensor * q = ggml_rope_ext(ctx0, section(0), pos, nullptr, head_dim, GGML_ROPE_TYPE_NORMAL, 0, 10000.0f, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+    ggml_tensor * k = ggml_rope_ext(ctx0, section(1), pos, nullptr, head_dim, GGML_ROPE_TYPE_NORMAL, 0, 10000.0f, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+    ggml_tensor * v = section(2);
+
+    ggml_tensor * k_full = ggml_concat(ctx0, state_in.at("tfm_k_" + sfx), ggml_reshape_2d(ctx0, k, d, N), 1); // [d, n_kv]
+    ggml_tensor * v_full = ggml_concat(ctx0, state_in.at("tfm_v_" + sfx), ggml_reshape_2d(ctx0, v, d, N), 1);
+    state_out.push_back({"tfm_k_" + sfx, ggml_cont(ctx0, ggml_view_2d(ctx0, k_full, d, prefix, k_full->nb[1], (size_t) N * k_full->nb[1]))});
+    state_out.push_back({"tfm_v_" + sfx, ggml_cont(ctx0, ggml_view_2d(ctx0, v_full, d, prefix, v_full->nb[1], (size_t) N * v_full->nb[1]))});
+
+    // key j is visible to query i iff 0 <= (prefix + i) - j < W and j >= prefix - base (cold start)
+    ggml_tensor * pos_k = ggml_reshape_2d(ctx0, ggml_arange(ctx0, 0.0f, (float) n_kv, 1.0f), n_kv, 1);
+    ggml_tensor * pos_q = ggml_reshape_2d(ctx0, ggml_arange(ctx0, (float) prefix, (float) (prefix + N), 1.0f), 1, N);
+    ggml_tensor * diff  = ggml_sub(ctx0, ggml_repeat_4d(ctx0, pos_q, n_kv, N, 1, 1), pos_k); // [n_kv, N]
+    ggml_tensor * keep  = ggml_mul(ctx0, ggml_step(ctx0, ggml_scale_bias(ctx0, diff, 1.0f, 0.5f)),
+                                         ggml_step(ctx0, ggml_scale_bias(ctx0, diff, -1.0f, (float) W - 0.5f)));
+    keep = ggml_mul(ctx0, keep, ggml_step(ctx0, ggml_scale_bias(ctx0, ggml_add(ctx0, pos_k, base), 1.0f, 0.5f - (float) prefix)));
+    ggml_tensor * mask = ggml_reshape_4d(ctx0, ggml_log(ctx0, keep), n_kv, N, 1, 1); // 0 = keep, -inf = masked
+    if (flash_attn_type == MTMD_FLASH_ATTN_TYPE_ENABLED) {
+        mask = ggml_cast(ctx0, mask, GGML_TYPE_F16);
+    }
+
+    ggml_tensor * attn = build_attn(l.wo_w, nullptr,
+                                    ggml_reshape_4d(ctx0, q, head_dim, n_head, N, 1),
+                                    ggml_reshape_4d(ctx0, k_full, head_dim, n_head, n_kv, 1),
+                                    ggml_reshape_4d(ctx0, v_full, head_dim, n_head, n_kv, 1),
+                                    mask, 1.0f / sqrtf((float) head_dim), il);
+    x = ggml_add(ctx0, x, ggml_mul(ctx0, attn, l.attn_scale));
+
+    h = zonos3_layer_norm(ctx0, x, l.norm2_w, l.norm2_b, ln_eps);
+    h = ggml_mul_mat(ctx0, l.ffn2_w, ggml_gelu_erf(ctx0, ggml_mul_mat(ctx0, l.ffn1_w, h)));
+    return ggml_add(ctx0, x, ggml_mul(ctx0, h, l.ffn_scale));
+}
+
+ggml_cgraph * mtmd_graph_zonos3_gen::build_gen_wav() {
+    const auto & z = model.zonos3;
+    const int64_t T = n_frames;
+
+    for (const auto & slot : list_zonos3_gen_state_slots(hparams, model)) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, slot.ne0, slot.ne1);
+        ggml_set_name(t, ("state_in_" + slot.name).c_str());
+        ggml_set_input(t);
+        state_in[slot.name] = t;
+    }
+
+    // codebook-major, residual codes are rows of the merged table
+    ggml_tensor * inp_codes = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, T * n_codebooks);
+    ggml_set_name(inp_codes, "inp_codes");
+    ggml_set_input(inp_codes);
+    auto codes_of = [&](int c) {
+        return ggml_view_1d(ctx0, inp_codes, T, (size_t) c * T * ggml_element_size(inp_codes));
+    };
+
+    // 1 for a known residual code, 0 for a missing one (early decode of a frame), codebook-major
+    ggml_tensor * inp_keep = ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, T * (n_codebooks - 1));
+    ggml_set_name(inp_keep, "inp_keep");
+    ggml_set_input(inp_keep);
+
+    ggml_tensor * x = ggml_add(ctx0, ggml_get_rows(ctx0, z.sem_table, codes_of(0)), z.sem_bias); // [semantic_dim, T]
+    for (size_t i = 0; i < z.sem.size(); i++) {
+        x = convnext(x, z.sem[i], "sem_conv_" + std::to_string(i));
+    }
+    x = ggml_add(ctx0, ggml_mul_mat(ctx0, z.sem_out_w, x), z.sem_out_b); // [latent, T]
+    for (int c = 1; c < n_codebooks; c++) {
+        ggml_tensor * bias = ggml_view_1d(ctx0, z.res_bias, z.res_bias->ne[0], (size_t) (c - 1) * z.res_bias->nb[1]);
+        ggml_tensor * keep = ggml_view_2d(ctx0, inp_keep, 1, T, ggml_element_size(inp_keep), (size_t) (c - 1) * T * ggml_element_size(inp_keep));
+        x = ggml_add(ctx0, x, ggml_mul(ctx0, ggml_add(ctx0, ggml_get_rows(ctx0, z.res_table, codes_of(c)), bias), keep));
+    }
+    cb(x, "zac_latent", -1);
+
+    ggml_tensor * frames = ggml_reshape_1d(ctx0, state_in.at("pos"), 1);
+    int cpf = 1; // positions per frame
+    for (int s = 0; s < n_stages; s++) {
+        const auto & st = z.stages[s];
+        x = ggml_mul_mat(ctx0, st.in_w, x);
+        ggml_tensor * base = ggml_scale(ctx0, frames, (float) cpf);
+        for (size_t il = 0; il < st.layers.size(); il++) {
+            x = moss_layer(x, st.layers[il], s, (int) il, base);
+        }
+        if (st.out_w) {
+            x = ggml_mul_mat(ctx0, st.out_w, x);
+        }
+        if (s + 1 < n_stages) {
+            // patch up x2: out[ch, 2t + j] = in[2ch + j, t]
+            const int64_t C = x->ne[0], N = x->ne[1];
+            x = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, x, 2, C / 2, N), 1, 0, 2, 3));
+            x = ggml_reshape_2d(ctx0, x, C / 2, 2 * N);
+            cpf *= 2;
+        }
+        cb(x, "zac_stage_out", s);
+    }
+    state_out.push_back({"pos", ggml_scale_bias(ctx0, state_in.at("pos"), 1.0f, (float) T)});
+
+    for (size_t i = 0; i < z.head.size(); i++) {
+        x = convnext(x, z.head[i], "head_conv_" + std::to_string(i));
+    }
+    x = zonos3_layer_norm(ctx0, x, z.head_norm_w, z.head_norm_b, convnext_eps);
+    ggml_tensor * spec = ggml_add(ctx0, ggml_mul_mat(ctx0, z.head_out_w, x), z.head_out_b); // [n_fft0 + 2 + n_fft1 + 2, 16T]
+    ggml_set_name(spec, "out_feats");
+    ggml_set_output(spec);
+    ggml_build_forward_expand(gf, spec);
+
+    for (auto & slot : state_out) {
+        ggml_set_name(slot.second, ("state_out_" + slot.first).c_str());
+        ggml_set_output(slot.second);
+        ggml_build_forward_expand(gf, slot.second);
+    }
+    return gf;
+}
+
+ggml_cgraph * mtmd_graph_zonos3_gen::build() {
+    return gen_process == MTMD_SUBCTX_GEN_PROCESS_GEN_WAV ? build_gen_wav() : build_gen_code();
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/zonos3-spkenc.cpp b/vendor/llama.cpp/tools/mtmd/models/zonos3-spkenc.cpp
new file mode 100644
index 0000000..94a388c
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/zonos3-spkenc.cpp
@@ -0,0 +1,221 @@
+#include "models.h"
+
+// zonos3 speaker encoder: MECT-B2 + ASTP pooling (ownmect_s2), then the speaker projection of the backbone
+// ported from the reference ggml runtime (spk-encoder.cpp)
+
+namespace {
+
+constexpr int kHidden   = 64;
+constexpr int kFeat     = 2560;
+constexpr int kHeads    = 4;
+constexpr int kExperts  = 4;
+constexpr int kPosK     = 113;
+
+// per block: cnn depth, stride f, stride t
+struct mect_block { int cnn, s_f, s_t; };
+const std::vector<std::vector<mect_block>> & mect_b2() {
+    static const std::vector<std::vector<mect_block>> cfg = {
+        { {3, 1, 1}, {3, 1, 1} },
+        { {3, 2, 1}, {3, 1, 2}, {3, 1, 2}, {3, 1, 2} },
+        { {3, 2, 1}, {3, 1, 2}, {3, 1, 2}, {3, 1, 2}, {3, 1, 2} },
+        { {3, 2, 1}, {2, 1, 2}, {2, 1, 2} },
+    };
+    return cfg;
+}
+
+} // namespace
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::W(const std::string & name) const {
+    return model.zonos3_spk.at("a.spk." + name);
+}
+
+bool mtmd_graph_zonos3_spkenc::has(const std::string & name) const {
+    return model.zonos3_spk.count("a.spk." + name) > 0;
+}
+
+// [C] as a per-channel broadcast over a [T, F, C] activation
+ggml_tensor * mtmd_graph_zonos3_spkenc::chan(ggml_tensor * v) const {
+    return ggml_reshape_4d(ctx0, v, 1, 1, v->ne[0], 1);
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::bn(ggml_tensor * x, const std::string & p) const {
+    return ggml_add(ctx0, ggml_mul(ctx0, x, chan(W(p + ".scale"))), chan(W(p + ".shift")));
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::conv(ggml_tensor * x, const std::string & p, int s_t, int s_f, bool bias, int pad) const {
+    ggml_tensor * y = ggml_conv_2d_direct(ctx0, W(p + ".weight"), x, s_t, s_f, pad, pad, 1, 1);
+    return bias ? ggml_add(ctx0, y, chan(W(p + ".bias"))) : y;
+}
+
+// grouped 3x3 conv as one depthwise conv per input slot of a group
+ggml_tensor * mtmd_graph_zonos3_spkenc::grouped3x3(ggml_tensor * x, const std::string & p, int s_t, int s_f) const {
+    int n_slot = 0;
+    while (has(p + ".w" + std::to_string(n_slot))) {
+        n_slot++;
+    }
+    const int64_t T  = x->ne[0];
+    const int64_t F  = x->ne[1];
+    const int64_t IC = x->ne[2];
+    const int64_t OC = W(p + ".w0")->ne[3];
+    const int64_t G  = IC / n_slot;
+    const int64_t B  = OC / G;
+    ggml_tensor * x4 = ggml_reshape_4d(ctx0, x, T, F, n_slot, G);
+    ggml_tensor * y  = nullptr;
+    for (int j = 0; j < n_slot; j++) {
+        ggml_tensor * xj = x;
+        if (n_slot > 1 || B > 1) {
+            ggml_tensor * slot = ggml_view_4d(ctx0, x4, T, F, 1, G, x4->nb[1], x4->nb[2], x4->nb[3], (size_t) j * x4->nb[2]);
+            xj = ggml_reshape_3d(ctx0, ggml_repeat_4d(ctx0, slot, T, F, B, G), T, F, OC);
+        }
+        ggml_tensor * t = ggml_conv_2d_dw_direct(ctx0, W(p + ".w" + std::to_string(j)), xj, s_t, s_f, 1, 1, 1, 1);
+        y = y ? ggml_add(ctx0, y, t) : t;
+    }
+    return y;
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::res_block(ggml_tensor * x, const std::string & q, int s_f, int s_t) const {
+    ggml_tensor * t = grouped3x3(x, q + "conv1", s_t, s_f);
+    t = ggml_relu(ctx0, bn(conv(t, q + "pw1", 1, 1, true, 0), q + "bn1"));
+    t = grouped3x3(t, q + "conv2", 1, 1);
+    t = ggml_relu(ctx0, bn(conv(t, q + "pw2", 1, 1, true, 0), q + "bn2"));
+    ggml_tensor * sc = x;
+    if (has(q + "sc.weight")) {
+        sc = bn(conv(x, q + "sc", s_t, s_f, false, 0), q + "sc.bn");
+    }
+    return ggml_add(ctx0, t, sc);
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::linear(ggml_tensor * x, const std::string & p) const {
+    return ggml_add(ctx0, ggml_mul_mat(ctx0, W(p + ".weight"), x), W(p + ".bias"));
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::layer_norm(ggml_tensor * x, const std::string & p) const {
+    return ggml_add(ctx0, ggml_mul(ctx0, ggml_norm(ctx0, x, 1e-6f), W(p + ".weight")), W(p + ".bias"));
+}
+
+// [T, F, C] -> [F*C, T], k = f*C + c
+ggml_tensor * mtmd_graph_zonos3_spkenc::flatten(ggml_tensor * x) const {
+    const int64_t T = x->ne[0], F = x->ne[1], C = x->ne[2];
+    return ggml_reshape_2d(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, x, 2, 1, 0, 3)), F * C, T);
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::unflatten(ggml_tensor * x, int64_t F, int64_t C) const {
+    return ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, x, C, F, x->ne[1]), 2, 1, 0, 3));
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::attention(ggml_tensor * h, const std::string & p) const {
+    const int64_t T  = h->ne[1];
+    const int     hd = kHidden / kHeads;
+    ggml_tensor * q = ggml_scale(ctx0, linear(h, p + "attn.q"), 1.0f / sqrtf((float) hd));
+    ggml_tensor * k = linear(h, p + "attn.k");
+    ggml_tensor * v = linear(h, p + "attn.v");
+    auto heads = [&](ggml_tensor * z) { // [64, T] -> [hd, T, n_head]
+        return ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, z, hd, kHeads, T), 0, 2, 1, 3));
+    };
+    ggml_tensor * qp = heads(q);
+    ggml_tensor * kp = heads(k);
+    ggml_tensor * vt = ggml_cont(ctx0, ggml_permute(ctx0, heads(v), 1, 0, 2, 3)); // [T, hd, n_head]
+    // queries in blocks, so long clips do not need a T x T score matrix per head
+    ggml_tensor * o = nullptr;
+    for (int64_t a = 0; a < T; a += 512) {
+        const int64_t nq = std::min<int64_t>(512, T - a);
+        ggml_tensor * qb    = ggml_view_3d(ctx0, qp, hd, nq, kHeads, qp->nb[1], qp->nb[2], (size_t) a * qp->nb[1]);
+        ggml_tensor * score = ggml_soft_max(ctx0, ggml_mul_mat(ctx0, kp, qb)); // [T, nq, n_head]
+        ggml_tensor * ob    = ggml_mul_mat(ctx0, vt, score);                   // [hd, nq, n_head]
+        ob = ggml_reshape_2d(ctx0, ggml_cont(ctx0, ggml_permute(ctx0, ob, 0, 2, 1, 3)), kHidden, nq);
+        o = o ? ggml_concat(ctx0, o, ob, 1) : ob;
+    }
+    return linear(o, p + "attn.o");
+}
+
+// soft MoE: all experts run, weighted by the router
+ggml_tensor * mtmd_graph_zonos3_spkenc::moe_ffn(ggml_tensor * h, const std::string & p) const {
+    ggml_tensor * r = ggml_soft_max(ctx0, ggml_mul_mat(ctx0, W(p + "moe.gate.weight"), h)); // [n_expert, T]
+    ggml_tensor * e = ggml_gelu(ctx0, ggml_mul_mat(ctx0, W(p + "moe.experts.weight"), h));  // [64 * n_expert, T]
+    ggml_tensor * mix = nullptr;
+    for (int i = 0; i < kExperts; i++) {
+        ggml_tensor * ei = ggml_view_2d(ctx0, e, kHidden, e->ne[1], e->nb[1], (size_t) i * kHidden * ggml_element_size(e));
+        ggml_tensor * ri = ggml_view_2d(ctx0, r, 1, r->ne[1], r->nb[1], (size_t) i * ggml_element_size(r));
+        ggml_tensor * t  = ggml_mul(ctx0, ei, ri);
+        mix = mix ? ggml_add(ctx0, mix, t) : t;
+    }
+    return linear(ggml_gelu(ctx0, mix), p + "ffn_out");
+}
+
+ggml_tensor * mtmd_graph_zonos3_spkenc::pos_conv(ggml_tensor * h, const std::string & p) const {
+    const int64_t T = h->ne[1];
+    ggml_tensor * ht = ggml_cont(ctx0, ggml_transpose(ctx0, h));               // [T, 64]
+    ht = ggml_pad_ext(ctx0, ht, kPosK / 2, kPosK / 2, 0, 0, 0, 0, 0, 0);        // [T + K - 1, 64]
+    ggml_tensor * acc = ggml_ssm_conv(ctx0, ggml_reshape_3d(ctx0, ht, ht->ne[0], kHidden, 1), W(p + "pos.dw.weight")); // [64, T, 1]
+    acc = ggml_add(ctx0, ggml_reshape_2d(ctx0, acc, kHidden, T), W(p + "pos.dw.bias"));
+    acc = ggml_add(ctx0, ggml_mul(ctx0, acc, W(p + "pos.bn.scale")), W(p + "pos.bn.shift"));
+    acc = ggml_gelu_erf(ctx0, acc);
+    return linear(acc, p + "pos.pw");
+}
+
+ggml_cgraph * mtmd_graph_zonos3_spkenc::build() {
+    const int64_t T = img.nx();
+    const int64_t n_mel = img.ny();
+
+    ggml_tensor * inp = ggml_new_tensor_4d(ctx0, GGML_TYPE_F32, T, n_mel, 1, 1);
+    ggml_set_name(inp, "inp_raw");
+    ggml_set_input(inp);
+
+    ggml_tensor * x  = bn(conv(inp, "fe.head.conv", 1, 1, true, 1), "fe.head.bn"); // [T, F, C]
+    ggml_tensor * xf = flatten(x);
+    std::vector<ggml_tensor *> feats;
+    const auto & stages = mect_b2();
+    for (size_t s = 0; s < stages.size(); s++) {
+        for (size_t k = 0; k < stages[s].size(); k++) {
+            const auto & b = stages[s][k];
+            const std::string p = "fe.b" + std::to_string(s + 1) + "." + std::to_string(k) + ".";
+            ggml_tensor * y = x;
+            for (int r = 0; r < b.cnn; r++) {
+                y = res_block(y, p + "cnn." + std::to_string(r) + ".", r == 0 ? b.s_f : 1, r == 0 ? b.s_t : 1);
+            }
+            if (has(p + "reduce.weight")) {
+                y = bn(conv(y, p + "reduce", 1, 1, true, 0), p + "reduce.bn");
+            }
+            const int64_t F2 = y->ne[1], C2 = y->ne[2];
+            ggml_tensor * x2 = flatten(y); // [2560, T']
+            ggml_tensor * h  = layer_norm(linear(x2, p + "rproj"), p + "rproj.ln");
+            h = ggml_add(ctx0, h, pos_conv(h, p));
+            h = layer_norm(ggml_add(ctx0, h, attention(h, p)), p + "ln1");
+            h = layer_norm(ggml_add(ctx0, h, moe_ffn(h, p)), p + "ln2");
+            ggml_tensor * e = ggml_add(ctx0, linear(h, p + "eproj"), x2);
+            if (b.s_t > 1) {
+                // nearest upsampling back to the input frames
+                const int64_t Tp = e->ne[1];
+                e = ggml_repeat_4d(ctx0, ggml_reshape_3d(ctx0, e, kFeat, 1, Tp), kFeat, b.s_t, Tp, 1);
+                e = ggml_view_2d(ctx0, ggml_reshape_2d(ctx0, e, kFeat, (int64_t) b.s_t * Tp), kFeat, T, e->nb[1], 0);
+            }
+            xf = ggml_add(ctx0, e, xf);
+            x  = unflatten(xf, F2, C2);
+        }
+        feats.push_back(xf);
+    }
+
+    ggml_tensor * dense = W("fe.dense_w"); // [2560, n_stage]
+    ggml_tensor * fused = nullptr;
+    for (size_t s = 0; s < feats.size(); s++) {
+        ggml_tensor * t = ggml_mul(ctx0, feats[s], ggml_view_2d(ctx0, dense, kFeat, 1, dense->nb[1], s * dense->nb[1]));
+        fused = fused ? ggml_add(ctx0, fused, t) : t;
+    }
+
+    // ASTP: attention-weighted mean and std over time
+    ggml_tensor * att   = linear(ggml_tanh(ctx0, linear(fused, "pool.l1")), "pool.l2");   // [2560, T]
+    ggml_tensor * alpha = ggml_soft_max(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, att))); // [T, 2560]
+    ggml_tensor * xt    = ggml_cont(ctx0, ggml_transpose(ctx0, fused));                    // [T, 2560]
+    ggml_tensor * mean  = ggml_sum_rows(ctx0, ggml_mul(ctx0, alpha, xt));                  // [1, 2560]
+    ggml_tensor * sq    = ggml_sum_rows(ctx0, ggml_mul(ctx0, alpha, ggml_mul(ctx0, xt, xt)));
+    ggml_tensor * var   = ggml_sub(ctx0, sq, ggml_mul(ctx0, mean, mean));
+    ggml_tensor * stdv  = ggml_sqrt(ctx0, ggml_clamp(ctx0, var, 1e-7f, 3.0e38f));
+    ggml_tensor * pooled = ggml_concat(ctx0, ggml_reshape_2d(ctx0, mean, kFeat, 1), ggml_reshape_2d(ctx0, stdv, kFeat, 1), 0);
+    pooled = ggml_add(ctx0, ggml_mul(ctx0, pooled, W("bn.scale")), W("bn.shift"));
+    ggml_tensor * spk = ggml_mul_mat(ctx0, W("linear.weight"), pooled); // [192, 1], not normalized
+    cb(spk, "spk_embd", -1);
+
+    ggml_tensor * out = linear(spk, "proj"); // speaker row of the prompt
+    ggml_build_forward_expand(gf, out);
+    return gf;
+}
