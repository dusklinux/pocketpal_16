+#include "models.h"
+
+#include <cmath>
+
+// LFM3-Audio generation
+//
+// GEN_CODE: one MaskGIT pass of the depthformer, hidden state + known codes (-1 = masked) -> logits per codebook
+//           once all codes are known, only the feedback embedding is built
+// GEN_WAV : a window of frames -> polar STFT frames of the liquid-codec decoder, the ISTFT runs on the host
+
+// state carried between GEN_WAV calls: rope offset, short-conv taps and attention window of the codec decoder
+std::vector<c2w_state_slot> list_lfm3a_gen_state_slots(const mtmd_hparams & hparams, const mtmd_model & model) {
+    std::vector<c2w_state_slot> slots;
+    if (model.c2w.tfm_layers.empty()) {
+        return slots;
+    }
+    const int64_t prefix = hparams.wav_tfm_swa - 1;
+    slots.push_back({"pos", 1, 1});
+    for (size_t il = 0; il < model.c2w.tfm_layers.size(); il++) {
+        const auto & layer = model.c2w.tfm_layers[il];
+        if (layer.conv_dw_w) {
+            slots.push_back({"conv_" + std::to_string(il), layer.conv_dw_w->ne[0] - 1, hparams.wav_tfm_n_embd});
+        } else {
+            slots.push_back({"k_" + std::to_string(il), layer.k_w->ne[1], prefix});
+            slots.push_back({"v_" + std::to_string(il), layer.v_w->ne[1], prefix});
+        }
+    }
+    return slots;
+}
+
+// pre-norm LFM block, with the LFM3 sandwich norms when the layer has them
+ggml_tensor * mtmd_graph_lfm3a_gen::build_lfm_layer(ggml_tensor * inpL, const mtmd_layer & layer, float eps, int il,
+                                                    const std::function<ggml_tensor *(ggml_tensor *)> & op) {
+    ggml_tensor * cur = build_norm(inpL, layer.ln_1_w, nullptr, NORM_TYPE_RMS, eps, il);
+    cur = op(cur);
+    if (layer.attn_post_norm_w) {
+        cur = build_norm(cur, layer.attn_post_norm_w, nullptr, NORM_TYPE_RMS, eps, il);
+    }
+    inpL = ggml_add(ctx0, cur, inpL);
+
+    cur = build_norm(inpL, layer.ln_2_w, nullptr, NORM_TYPE_RMS, eps, il);
+    cur = build_ffn(cur, layer.ff_up_w, nullptr, layer.ff_gate_w, nullptr, layer.ff_down_w, nullptr, FFN_SILU, il);
+    if (layer.ff_post_norm_w) {
+        cur = build_norm(cur, layer.ff_post_norm_w, nullptr, NORM_TYPE_RMS, eps, il);
+    }
+    return ggml_add(ctx0, inpL, cur);
+}
+
+// GQA with q/k RMSNorm, NEOX rope, an optional cached K/V prefix and the LFM3 per-head sigmoid gate
+ggml_tensor * mtmd_graph_lfm3a_gen::build_lfm_attn(ggml_tensor * cur, const mtmd_layer & layer, int n_head, int n_head_kv,
+                                                   float eps, float rope_theta, int il, ggml_tensor * inp_pos,
+                                                   ggml_tensor * kq_mask, ggml_tensor * k_cache, ggml_tensor * v_cache,
+                                                   ggml_tensor ** k_all, ggml_tensor ** v_all) {
+    const int64_t n_pos   = cur->ne[1];
+    const int64_t head_dim = layer.q_norm->ne[0];
+
+    ggml_tensor * Qcur = ggml_reshape_3d(ctx0, build_mm(layer.q_w, cur), head_dim, n_head,    n_pos);
+    ggml_tensor * Kcur = ggml_reshape_3d(ctx0, build_mm(layer.k_w, cur), head_dim, n_head_kv, n_pos);
+    ggml_tensor * Vcur = build_mm(layer.v_w, cur);
+
+    Qcur = build_norm(Qcur, layer.q_norm, nullptr, NORM_TYPE_RMS, eps, il);
+    Kcur = build_norm(Kcur, layer.k_norm, nullptr, NORM_TYPE_RMS, eps, il);
+    Qcur = ggml_rope_ext(ctx0, Qcur, inp_pos, nullptr, head_dim, GGML_ROPE_TYPE_NEOX, 0, rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+    Kcur = ggml_rope_ext(ctx0, Kcur, inp_pos, nullptr, head_dim, GGML_ROPE_TYPE_NEOX, 0, rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+
+    ggml_tensor * k = ggml_reshape_2d(ctx0, Kcur, head_dim * n_head_kv, n_pos);
+    ggml_tensor * v = Vcur;
+    if (k_cache) {
+        k = ggml_concat(ctx0, k_cache, k, 1);
+        v = ggml_concat(ctx0, v_cache, v, 1);
+    }
+    if (k_all) {
+        *k_all = k;
+        *v_all = v;
+    }
+    const int64_t n_kv = k->ne[1];
+
+    ggml_tensor * attn = build_attn(layer.attn_gate_w ? nullptr : layer.o_w, nullptr,
+        Qcur,
+        ggml_reshape_3d(ctx0, k, head_dim, n_head_kv, n_kv),
+        ggml_reshape_3d(ctx0, v, head_dim, n_head_kv, n_kv),
+        kq_mask, 1.0f / sqrtf((float) head_dim), il);
+    if (layer.attn_gate_w) {
+        ggml_tensor * gate = ggml_sigmoid(ctx0, build_mm(layer.attn_gate_w, cur));
+        attn = ggml_mul(ctx0, ggml_reshape_3d(ctx0, attn, head_dim, n_head, n_pos), ggml_reshape_3d(ctx0, gate, 1, n_head, n_pos));
+        attn = build_mm(layer.o_w, ggml_reshape_2d(ctx0, attn, head_dim * n_head, n_pos));
+    }
+    return attn;
+}
+
+// short conv: in_proj -> b * x -> causal depthwise conv over [conv_state | x] -> c * conv -> out_proj
+ggml_tensor * mtmd_graph_lfm3a_gen::build_lfm_conv(ggml_tensor * cur, const mtmd_layer & layer, int il,
+                                                   ggml_tensor * conv_state, ggml_tensor ** conv_state_out) {
+    const int64_t n_embd_c = cur->ne[0];
+    const int64_t n_pos    = cur->ne[1];
+
+    ggml_tensor * bcx = build_mm(layer.conv_pw1_w, cur);
+    ggml_tensor * b = ggml_view_2d(ctx0, bcx, n_embd_c, n_pos, bcx->nb[1], 0);
+    ggml_tensor * c = ggml_view_2d(ctx0, bcx, n_embd_c, n_pos, bcx->nb[1], ggml_row_size(bcx->type, n_embd_c));
+    ggml_tensor * x = ggml_view_2d(ctx0, bcx, n_embd_c, n_pos, bcx->nb[1], ggml_row_size(bcx->type, 2 * n_embd_c));
+
+    ggml_tensor * bx = ggml_cont(ctx0, ggml_transpose(ctx0, ggml_mul(ctx0, b, x)));
+    bx = ggml_concat(ctx0, conv_state, bx, 0);
+    const int64_t d_conv = conv_state->ne[0];
+    *conv_state_out = ggml_cont(ctx0, ggml_view_2d(ctx0, bx, d_conv, n_embd_c, bx->nb[1], (size_t) n_pos * bx->nb[0]));
+
+    cur = ggml_ssm_conv(ctx0, ggml_reshape_3d(ctx0, bx, bx->ne[0], n_embd_c, 1), layer.conv_dw_w);
+    cur = ggml_mul(ctx0, c, ggml_reshape_2d(ctx0, cur, n_embd_c, n_pos));
+    cb(cur, "conv", il);
+    return build_mm(layer.conv_pw2_w, cur);
+}
+
+ggml_tensor * mtmd_graph_lfm3a_gen::build_gen_code() {
+    ggml_tensor * embd_w = model.gen_code_embd_w; // [n_embd, n_vocab, n_codebooks], tied to the output head
+    const int64_t n_cb    = embd_w->ne[2];
+    const int64_t n_vocab = embd_w->ne[1];
+
+    // rows of the merged per-codebook tables: code + codebook * n_vocab
+    ggml_tensor * inp_codes = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_cb);
+    ggml_set_name(inp_codes, "inp_codes");
+    ggml_set_input(inp_codes);
+
+    // feedback embedding for the backbone
+    ggml_tensor * fb = ggml_get_rows(ctx0, model.gen_code_out_embd_w, inp_codes); // [n_mmproj_embd, n_cb]
+    fb = ggml_sum_rows(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, fb)));
+    fb = ggml_reshape_2d(ctx0, fb, n_mmproj_embd, 1);
+    cb(fb, "gen_embd", -1);
+    if (all_known) {
+        return fb;
+    }
+
+    ggml_tensor * h_state = ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_mmproj_embd);
+    ggml_set_name(h_state, "inp_raw");
+    ggml_set_input(h_state);
+
+    // 1 for a revealed codebook, 0 for a masked one
+    ggml_tensor * inp_mask = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, 1, n_cb);
+    ggml_set_name(inp_mask, "inp_mask");
+    ggml_set_input(inp_mask);
+
+    // one position per codebook: projected hidden state + token embedding or the mask embedding
+    ggml_tensor * cur = ggml_add(ctx0, build_mm(model.gen_code_proj_in_w, h_state), model.gen_code_proj_in_b);
+    cur = ggml_reshape_2d(ctx0, cur, n_embd, n_cb);
+
+    ggml_tensor * tok = ggml_get_rows(ctx0, ggml_reshape_2d(ctx0, embd_w, n_embd, n_vocab * n_cb), inp_codes);
+    tok = ggml_mul(ctx0, tok, inp_mask);
+    ggml_tensor * msk = ggml_mul(ctx0, ggml_repeat(ctx0, model.gen_code_mask_embd, cur), ggml_scale_bias(ctx0, inp_mask, -1.0f, 1.0f));
+    cur = ggml_add(ctx0, cur, ggml_add(ctx0, tok, msk));
+    cb(cur, "depth_inp", -1);
+
+    // bidirectional: no mask, no state
+    ggml_tensor * inp_pos = ggml_cast(ctx0, ggml_arange(ctx0, 0.0f, (float) n_cb, 1.0f), GGML_TYPE_I32);
+    for (int il = 0; il < n_layer; il++) {
+        const auto & layer = model.layers[il];
+        cur = build_lfm_layer(cur, layer, eps, il, [&](ggml_tensor * x) {
+            return build_lfm_attn(x, layer, hparams.n_head, hparams.n_head_kv, eps, hparams.rope_theta, il, inp_pos,
+                                  nullptr, nullptr, nullptr, nullptr, nullptr);
+        });
+    }
+
+    cur = build_norm(cur, model.gen_code_norm_w, nullptr, NORM_TYPE_RMS, eps, -1);
+    cur = build_norm(cur, model.gen_code_head_norm_w, nullptr, NORM_TYPE_RMS, eps, -1); // per codebook
+    ggml_tensor * logits = ggml_mul_mat(ctx0, embd_w, ggml_reshape_3d(ctx0, cur, n_embd, 1, n_cb)); // [n_vocab, 1, n_cb]
+    logits = ggml_reshape_2d(ctx0, logits, n_vocab, n_cb);
+    ggml_set_name(logits, "out_feats");
+    ggml_set_output(logits);
+    ggml_build_forward_expand(gf, logits);
+
+    return fb;
+}
+
+ggml_tensor * mtmd_graph_lfm3a_gen::build_gen_wav() {
+    const auto & c2w = model.c2w;
+    const int64_t n_cb   = model.gen_code_embd_w->ne[2];
+    const int64_t n_fs   = hparams.wav_frame_stack;
+    const int64_t n_pos  = n_fs * n_frames;
+    const int64_t prefix = hparams.wav_tfm_swa - 1;
+
+    // frame-major codes
+    ggml_tensor * inp_codes = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_cb * n_frames);
+    ggml_set_name(inp_codes, "inp_codes");
+    ggml_set_input(inp_codes);
+
+    std::map<std::string, ggml_tensor *> state_in;
+    std::vector<std::pair<std::string, ggml_tensor *>> state_out;
+    for (const auto & slot : list_lfm3a_gen_state_slots(hparams, model)) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, slot.ne0, slot.ne1);
+        ggml_set_name(t, ("state_in_" + slot.name).c_str());
+        ggml_set_input(t);
+        state_in[slot.name] = t;
+    }
+
+    // FSQ decode: every codebook shares the level table, one projection over the n_cb code vectors of a frame
+    ggml_tensor * q = ggml_get_rows(ctx0, c2w.quant_first_cb_w, inp_codes); // [n_lvl, n_cb * n_frames]
+    q = ggml_reshape_2d(ctx0, q, q->ne[0] * n_cb, n_frames);
+    ggml_tensor * cur = ggml_add(ctx0, build_mm(c2w.quant_first_out_w, q), c2w.quant_first_out_b);
+    cur = ggml_add(ctx0, build_mm(c2w.tfm_in_proj_w, cur), c2w.tfm_in_proj_b); // [n_embd_dec, n_frames]
+    const int64_t n_embd_dec = cur->ne[0];
+
+    // nearest-exact upsampling: every frame becomes n_fs decoder positions
+    cur = ggml_repeat_4d(ctx0, ggml_reshape_3d(ctx0, cur, n_embd_dec, 1, n_frames), n_embd_dec, n_fs, n_frames, 1);
+    cur = ggml_reshape_2d(ctx0, cur, n_embd_dec, n_pos);
+
+    // positions continue across calls from the "pos" slot, see mtmd_subcontext::encode()
+    ggml_tensor * inp_pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_pos);
+    ggml_set_name(inp_pos, "positions");
+    ggml_set_input(inp_pos);
+    state_out.push_back({"pos", ggml_scale_bias(ctx0, state_in.at("pos"), 1.0f, (float) n_pos)});
+
+    // sliding-window causal mask over [cached window | this chunk]
+    ggml_tensor * kq_mask = build_inp_attn_mask(prefix + n_pos, n_pos);
+
+    const float eps_dec = hparams.wav_tfm_eps;
+    for (size_t il = 0; il < c2w.tfm_layers.size(); il++) {
+        const auto & layer = c2w.tfm_layers[il];
+        cur = build_lfm_layer(cur, layer, eps_dec, (int) il, [&](ggml_tensor * x) {
+            if (layer.conv_dw_w) {
+                const std::string name = "conv_" + std::to_string(il);
+                ggml_tensor * st = nullptr;
+                ggml_tensor * out = build_lfm_conv(x, layer, (int) il, state_in.at(name), &st);
+                state_out.push_back({name, st});
+                return out;
+            }
+            // this chunk's tail of the window is kept for the next call
+            const std::string k_name = "k_" + std::to_string(il);
+            const std::string v_name = "v_" + std::to_string(il);
+            ggml_tensor * k = nullptr;
+            ggml_tensor * v = nullptr;
+            ggml_tensor * out = build_lfm_attn(x, layer, hparams.wav_tfm_n_head, hparams.wav_tfm_n_head_kv, eps_dec,
+                                               hparams.wav_tfm_rope_theta, (int) il, inp_pos, kq_mask,
+                                               state_in.at(k_name), state_in.at(v_name), &k, &v);
+            state_out.push_back({k_name, ggml_cont(ctx0, ggml_view_2d(ctx0, k, k->ne[0], prefix, k->nb[1], (size_t) n_pos * k->nb[1]))});
+            state_out.push_back({v_name, ggml_cont(ctx0, ggml_view_2d(ctx0, v, v->ne[0], prefix, v->nb[1], (size_t) n_pos * v->nb[1]))});
+            return out;
+        });
+    }
+
+    cur = build_norm(cur, c2w.tfm_output_norm_w, nullptr, NORM_TYPE_RMS, eps_dec, -1);
+    cur = ggml_add(ctx0, build_mm(c2w.tfm_out_proj_w, cur), c2w.tfm_out_proj_b); // [2 * n_bins, n_pos]
+    cb(cur, "polar_out", -1);
+
+    for (const auto & s : state_out) {
+        ggml_set_name(s.second, ("state_out_" + s.first).c_str());
+        ggml_set_output(s.second);
+        ggml_build_forward_expand(gf, s.second);
+    }
+
+    ggml_set_name(cur, "out_feats");
+    ggml_set_output(cur);
+    return cur;
+}
+
+ggml_cgraph * mtmd_graph_lfm3a_gen::build() {
+    ggml_tensor * out = gen_process == MTMD_SUBCTX_GEN_PROCESS_GEN_WAV ? build_gen_wav() : build_gen_code();
+    ggml_build_forward_expand(gf, out);
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/lfm3a.cpp b/vendor/llama.cpp/tools/mtmd/models/lfm3a.cpp
new file mode 100644
index 0000000..03128a2
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/lfm3a.cpp
@@ -0,0 +1,189 @@
+#include "models.h"
+
+// streaming encoder state: base position, conv left context, short-conv taps and attention window
+// a zero state gives the same result as encoding the whole clip
+std::vector<c2w_state_slot> list_lfm3a_state_slots(const mtmd_hparams & hparams, const mtmd_model & model) {
+    std::vector<c2w_state_slot> slots;
+
+    const int64_t n_mel  = hparams.n_mel_bins;
+    const int64_t n_ch   = model.pre_encode_conv_X_w[0]->ne[3];
+    const int64_t prefix = hparams.attn_window_size - 1;
+
+    slots.push_back({"pos", 1, 1});
+    slots.push_back({"ds0", 1, n_mel});
+    slots.push_back({"ds1", 1, (n_mel / 2) * n_ch});
+    slots.push_back({"ds2", 1, (n_mel / 4) * n_ch});
+    for (size_t il = 0; il < model.layers.size(); il++) {
+        const auto & layer = model.layers[il];
+        if (layer.conv_dw_w) {
+            slots.push_back({"conv_" + std::to_string(il), layer.conv_dw_w->ne[0] - 1, hparams.n_embd});
+        } else {
+            slots.push_back({"k_" + std::to_string(il), layer.k_w->ne[1], prefix});
+            slots.push_back({"v_" + std::to_string(il), layer.v_w->ne[1], prefix});
+        }
+    }
+
+    return slots;
+}
+
+// LFM3-Audio encoder: conv downsampler (8x in time) -> causal LFM2 stack -> MLP projector
+ggml_cgraph * mtmd_graph_lfm3a::build() {
+    const norm_type norm_t = NORM_TYPE_RMS;
+    const float rope_theta = hparams.rope_theta;
+    const int64_t prefix   = hparams.attn_window_size - 1;
+
+    // the graph always streams, a zero state encodes a clip from its start
+    std::map<std::string, ggml_tensor *> state_in;
+    std::vector<std::pair<std::string, ggml_tensor *>> state_out;
+    for (const auto & slot : list_lfm3a_state_slots(hparams, model)) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, slot.ne0, slot.ne1);
+        ggml_set_name(t, ("state_in_" + slot.name).c_str());
+        ggml_set_input(t);
+        state_in[slot.name] = t;
+    }
+
+    // stride-2 conv over [time, freq, ch]; the left column comes from the state and the right edge is zero-padded
+    auto conv_down = [&](ggml_tensor * x, const std::string & name, ggml_tensor * w, ggml_tensor * b, bool depthwise) {
+        ggml_tensor * left = ggml_reshape_4d(ctx0, state_in.at(name), 1, x->ne[1], x->ne[2], 1);
+        x = ggml_concat(ctx0, left, x, 0);
+        ggml_tensor * last = ggml_view_4d(ctx0, x, 1, x->ne[1], x->ne[2], 1, x->nb[1], x->nb[2], x->nb[3], (x->ne[0] - 1) * x->nb[0]);
+        state_out.push_back({name, ggml_reshape_2d(ctx0, ggml_cont(ctx0, last), 1, x->ne[1] * x->ne[2])});
+        x = ggml_pad_ext(ctx0, x, 0, 1, 0, 0, 0, 0, 0, 0);
+        x = depthwise ? ggml_conv_2d_dw_direct(ctx0, w, x, 2, 2, 0, 1, 1, 1)
+                      : ggml_conv_2d(ctx0, w, x, 2, 2, 0, 1, 1, 1);
+        return ggml_add(ctx0, x, b);
+    };
+
+    // inp: [n_frames, n_mel, 1]
+    ggml_tensor * cur = build_inp_raw(1);
+
+    // downsampler, same layout as the lfm2a pre-encoder but with SiLU
+    cur = conv_down(cur, "ds0", model.pre_encode_conv_X_w[0], model.pre_encode_conv_X_b[0], false);
+    cur = ggml_silu_inplace(ctx0, cur);
+
+    cur = conv_down(cur, "ds1", model.pre_encode_conv_X_w[2], model.pre_encode_conv_X_b[2], true);
+    cur = ggml_conv_2d_direct(ctx0, model.pre_encode_conv_X_w[3], cur, 1, 1, 0, 0, 1, 1);
+    cur = ggml_add(ctx0, cur, model.pre_encode_conv_X_b[3]);
+    cur = ggml_silu_inplace(ctx0, cur);
+
+    cur = conv_down(cur, "ds2", model.pre_encode_conv_X_w[5], model.pre_encode_conv_X_b[5], true);
+    cur = ggml_conv_2d_direct(ctx0, model.pre_encode_conv_X_w[6], cur, 1, 1, 0, 0, 1, 1);
+    cur = ggml_add(ctx0, cur, model.pre_encode_conv_X_b[6]);
+    cur = ggml_silu_inplace(ctx0, cur);
+    cb(cur, "downsample.conv", -1);
+
+    // [n_pos, n_mel/8, n_ch] -> [n_ch * n_mel/8, n_pos]
+    const int n_pos = cur->ne[0];
+    cur = ggml_reshape_2d(ctx0, cur, n_pos, cur->ne[1] * cur->ne[2]);
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    cur = build_mm(model.pre_encode_out_w, cur);
+    cur = ggml_add(ctx0, cur, model.pre_encode_out_b);
+    cb(cur, "downsample.out", -1);
+
+    ggml_tensor * positions = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_pos);
+    ggml_set_name(positions, "positions");
+    ggml_set_input(positions);
+    state_out.push_back({"pos", ggml_scale_bias(ctx0, state_in.at("pos"), 1.0f, (float) n_pos)});
+
+    // causal mask with a sliding window, shared by all attention layers
+    ggml_tensor * kq_mask = build_inp_attn_mask(prefix + n_pos, n_pos);
+
+    ggml_tensor * inpL = cur;
+
+    for (int il = 0; il < n_layer; il++) {
+        const auto & layer = model.layers[il];
+
+        cur = build_norm(inpL, layer.ln_1_w, nullptr, norm_t, eps, il);
+        cb(cur, "operator_norm", il);
+
+        if (layer.conv_dw_w) {
+            // short conv: in_proj -> b * x -> causal depthwise conv -> c * conv -> out_proj
+            ggml_tensor * bcx = build_mm(layer.conv_pw1_w, cur);
+            cb(bcx, "conv_in_proj", il);
+
+            ggml_tensor * b = ggml_view_2d(ctx0, bcx, n_embd, n_pos, bcx->nb[1], 0);
+            ggml_tensor * c = ggml_view_2d(ctx0, bcx, n_embd, n_pos, bcx->nb[1], ggml_row_size(bcx->type, n_embd));
+            ggml_tensor * x = ggml_view_2d(ctx0, bcx, n_embd, n_pos, bcx->nb[1], ggml_row_size(bcx->type, 2 * n_embd));
+
+            ggml_tensor * bx = ggml_cont(ctx0, ggml_transpose(ctx0, ggml_mul(ctx0, b, x)));
+            const int d_conv = layer.conv_dw_w->ne[0] - 1;
+            const std::string name = "conv_" + std::to_string(il);
+            bx = ggml_concat(ctx0, state_in.at(name), bx, 0);
+            state_out.push_back({name, ggml_cont(ctx0, ggml_view_2d(ctx0, bx, d_conv, n_embd, bx->nb[1], (size_t) n_pos * bx->nb[0]))});
+            bx = ggml_reshape_3d(ctx0, bx, bx->ne[0], n_embd, 1);
+
+            cur = ggml_ssm_conv(ctx0, bx, layer.conv_dw_w);
+            cur = ggml_reshape_2d(ctx0, cur, n_embd, n_pos);
+            cb(cur, "conv_conv", il);
+
+            cur = ggml_mul(ctx0, c, cur);
+            cur = build_mm(layer.conv_pw2_w, cur);
+            cb(cur, "conv_out_proj", il);
+        } else {
+            ggml_tensor * Qcur = build_mm(layer.q_w, cur);
+            ggml_tensor * Kcur = build_mm(layer.k_w, cur);
+            ggml_tensor * Vcur = build_mm(layer.v_w, cur);
+
+            Qcur = ggml_reshape_3d(ctx0, Qcur, d_head, n_head,    n_pos);
+            Kcur = ggml_reshape_3d(ctx0, Kcur, d_head, n_head_kv, n_pos);
+            Vcur = ggml_reshape_3d(ctx0, Vcur, d_head, n_head_kv, n_pos);
+
+            Qcur = build_norm(Qcur, layer.q_norm, nullptr, norm_t, eps, il);
+            Kcur = build_norm(Kcur, layer.k_norm, nullptr, norm_t, eps, il);
+
+            Qcur = ggml_rope_ext(ctx0, Qcur, positions, nullptr, d_head, GGML_ROPE_TYPE_NEOX, 0,
+                                 rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+            Kcur = ggml_rope_ext(ctx0, Kcur, positions, nullptr, d_head, GGML_ROPE_TYPE_NEOX, 0,
+                                 rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+
+            // the cached window goes in front, this chunk's tail is kept for the next call
+            const std::string k_name = "k_" + std::to_string(il);
+            const std::string v_name = "v_" + std::to_string(il);
+            const int64_t n_embd_kv = d_head * n_head_kv;
+            ggml_tensor * K = ggml_concat(ctx0, state_in.at(k_name), ggml_reshape_2d(ctx0, Kcur, n_embd_kv, n_pos), 1);
+            ggml_tensor * V = ggml_concat(ctx0, state_in.at(v_name), ggml_reshape_2d(ctx0, Vcur, n_embd_kv, n_pos), 1);
+            state_out.push_back({k_name, ggml_cont(ctx0, ggml_view_2d(ctx0, K, n_embd_kv, prefix, K->nb[1], (size_t) n_pos * K->nb[1]))});
+            state_out.push_back({v_name, ggml_cont(ctx0, ggml_view_2d(ctx0, V, n_embd_kv, prefix, V->nb[1], (size_t) n_pos * V->nb[1]))});
+            Kcur = ggml_reshape_3d(ctx0, K, d_head, n_head_kv, prefix + n_pos);
+            Vcur = ggml_reshape_3d(ctx0, V, d_head, n_head_kv, prefix + n_pos);
+
+            cur = build_attn(layer.o_w, nullptr, Qcur, Kcur, Vcur, kq_mask, kq_scale, il);
+            cb(cur, "attn_out", il);
+        }
+
+        cur = ggml_add(ctx0, cur, inpL);
+        inpL = cur;
+
+        cur = build_norm(cur, layer.ln_2_w, nullptr, norm_t, eps, il);
+        cb(cur, "ffn_norm", il);
+
+        cur = build_ffn(cur,
+            layer.ff_up_w, nullptr,
+            layer.ff_gate_w, nullptr,
+            layer.ff_down_w, nullptr,
+            FFN_SILU, il);
+        cb(cur, "ffn_out", il);
+
+        cur = ggml_add(ctx0, inpL, cur);
+        inpL = cur;
+    }
+
+    cur = build_norm(inpL, model.post_ln_w, nullptr, norm_t, eps, -1);
+    cb(cur, "embedding_norm", -1);
+
+    // projector: LayerNorm -> Linear -> GELU -> Linear
+    cur = build_norm(cur, model.mm_0_w, model.mm_0_b, NORM_TYPE_NORMAL, 1e-5, -1);
+    cur = build_ffn(cur, model.mm_1_w, model.mm_1_b, nullptr, nullptr, model.mm_3_w, model.mm_3_b, FFN_GELU_ERF, -1);
+    cb(cur, "projected", -1);
+
+    // the state outputs go first so that the embeddings stay the last node of the graph
+    for (const auto & s : state_out) {
+        ggml_set_name(s.second, ("state_out_" + s.first).c_str());
+        ggml_set_output(s.second);
+        ggml_build_forward_expand(gf, s.second);
+    }
+
+    ggml_build_forward_expand(gf, cur);
+
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/lfm3vl.cpp b/vendor/llama.cpp/tools/mtmd/models/lfm3vl.cpp
new file mode 100644
index 0000000..6ad64ec
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/lfm3vl.cpp
@@ -0,0 +1,183 @@
+#include "models.h"
+
+ggml_cgraph * mtmd_graph_lfm3vl::build() {
+    GGML_ASSERT(model.patch_embeddings_0 != nullptr);
+    GGML_ASSERT(model.lfm3vl_embedding_norm_w != nullptr);
+    GGML_ASSERT(model.class_embedding == nullptr);
+    GGML_ASSERT(n_batch == 1 || n_batch == 2);
+
+    const int batch_size       = 1;
+    const int n_pos            = n_patches;
+    const int num_position_ids = n_pos * 4; // m-rope requires 4 dim per position
+
+    const norm_type norm_t = NORM_TYPE_RMS;
+
+    // 2D rope: pairs (j, j+n_dims); first d_head/4 pairs rotate by y, next d_head/4 by x
+    int mrope_sections[4] = {d_head/4, d_head/4, 0, 0};
+
+    // one patchifier kernel per temporal slice: a still image fills both slices, video frames are merged in pairs
+    ggml_tensor * inp;
+    if (model.patch_embeddings_1 == nullptr) {
+        GGML_ASSERT(n_batch == 1);
+        inp = ggml_conv_2d(ctx0, model.patch_embeddings_0, build_inp_raw(), patch_size, patch_size, 0, 0, 1, 1);
+    } else {
+        inp = build_inp_temporal_merge();
+    }
+    inp = ggml_reshape_2d(ctx0, inp, n_pos, n_embd);
+    inp = ggml_cont(ctx0, ggml_transpose(ctx0, inp));
+    cb(inp, "patchifier_out", -1);
+
+    // the 2x2 interleave waits for the projector, the conv layers need raster-scan order
+    inp = build_norm(inp, model.lfm3vl_embedding_norm_w, nullptr, norm_t, eps, -1);
+    cb(inp, "embedding_norm", -1);
+
+    ggml_tensor * inpL = inp;
+
+    // position IDs for 2D RoPE (same format as Qwen3VL)
+    ggml_tensor * positions = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, num_position_ids);
+    ggml_set_name(positions, "positions");
+    ggml_set_input(positions);
+
+    const float rope_theta = hparams.rope_theta;
+
+    for (int il = 0; il < n_layer; il++) {
+        auto & layer = model.layers[il];
+
+        const bool is_conv_layer = (layer.conv2d_in_proj_w != nullptr);
+
+        ggml_tensor * cur = inpL;
+
+        cur = build_norm(cur, layer.ln_1_w, layer.ln_1_b, norm_t, eps, il);
+        cb(cur, "ln1", il);
+
+        if (is_conv_layer) {
+            ggml_tensor * proj = build_mm(layer.conv2d_in_proj_w, cur);
+            cb(proj, "conv_in_proj", il);
+
+            ggml_tensor * first  = ggml_view_2d(ctx0, proj, n_embd, n_pos,
+                proj->nb[1], 0);
+            ggml_tensor * middle = ggml_view_2d(ctx0, proj, n_embd, n_pos,
+                proj->nb[1], ggml_row_size(proj->type, n_embd));
+            ggml_tensor * third  = ggml_view_2d(ctx0, proj, n_embd, n_pos,
+                proj->nb[1], ggml_row_size(proj->type, 2 * n_embd));
+
+            ggml_tensor * gated = ggml_mul(ctx0, first, third);
+            cb(gated, "conv_gated", il);
+
+            ggml_tensor * conv_out;
+            if (layer.conv2d_spatial_w) {
+                ggml_tensor * gated_3d = ggml_reshape_4d(ctx0, gated,
+                    n_embd, n_patches_x, n_patches_y, batch_size);
+                ggml_tensor * gated_2d = ggml_cont(ctx0,
+                    ggml_permute(ctx0, gated_3d, 2, 0, 1, 3));
+                cb(gated_2d, "conv_gated_2d", il);
+
+                conv_out = ggml_conv_2d_dw_direct(ctx0, layer.conv2d_spatial_w, gated_2d,
+                    1, 1, 1, 1, 1, 1);
+                cb(conv_out, "conv_spatial", il);
+
+                conv_out = ggml_cont(ctx0,
+                    ggml_permute(ctx0, conv_out, 1, 2, 0, 3));
+                conv_out = ggml_reshape_2d(ctx0, conv_out, n_embd, n_pos);
+            } else {
+                conv_out = gated;
+            }
+
+            cur = ggml_mul(ctx0, middle, conv_out);
+            cb(cur, "conv_mul", il);
+
+            cur = build_mm(layer.conv2d_out_proj_w, cur);
+            cb(cur, "conv_out_proj", il);
+        } else {
+            ggml_tensor * Qcur = build_mm(layer.q_w, cur);
+            ggml_tensor * Kcur = build_mm(layer.k_w, cur);
+            ggml_tensor * Vcur = build_mm(layer.v_w, cur);
+
+            cb(Qcur, "Qcur", il);
+            cb(Kcur, "Kcur", il);
+            cb(Vcur, "Vcur", il);
+
+            Qcur = ggml_reshape_3d(ctx0, Qcur, d_head, n_head,    n_pos);
+            Kcur = ggml_reshape_3d(ctx0, Kcur, d_head, n_head_kv, n_pos);
+            Vcur = ggml_reshape_3d(ctx0, Vcur, d_head, n_head_kv, n_pos);
+
+            if (layer.q_norm) {
+                Qcur = build_norm(Qcur, layer.q_norm, nullptr, norm_t, eps, il);
+            }
+            if (layer.k_norm) {
+                Kcur = build_norm(Kcur, layer.k_norm, nullptr, norm_t, eps, il);
+            }
+
+            Qcur = ggml_rope_multi(
+                ctx0, Qcur, positions, nullptr,
+                d_head/2, mrope_sections, GGML_ROPE_TYPE_VISION,
+                32768, rope_theta, 1, 0, 1, 32, 1);
+            Kcur = ggml_rope_multi(
+                ctx0, Kcur, positions, nullptr,
+                d_head/2, mrope_sections, GGML_ROPE_TYPE_VISION,
+                32768, rope_theta, 1, 0, 1, 32, 1);
+
+            cb(Qcur, "Qcur_rope", il);
+            cb(Kcur, "Kcur_rope", il);
+
+            cur = build_attn(layer.o_w, layer.o_b,
+                Qcur, Kcur, Vcur, nullptr, kq_scale, il);
+            cb(cur, "attn_out", il);
+        }
+
+        cur = ggml_add(ctx0, cur, inpL);
+        inpL = cur;
+        cb(cur, "ffn_inp", il);
+
+        cur = build_norm(cur, layer.ln_2_w, layer.ln_2_b, norm_t, eps, il);
+        cb(cur, "ffn_inp_normed", il);
+
+        cur = build_ffn(cur,
+            layer.ff_up_w, layer.ff_up_b,
+            layer.ff_gate_w, layer.ff_gate_b,
+            layer.ff_down_w, layer.ff_down_b,
+            hparams.ffn_op, il);
+        cb(cur, "ffn_out", il);
+
+        cur = ggml_add(ctx0, inpL, cur);
+        cb(cur, "layer_out", il);
+
+        inpL = cur;
+    }
+
+    // no post-layernorm for LFM3-VL
+
+    ggml_tensor * embeddings = inpL;
+
+    // projector input LayerNorm, eps is projector_layer_norm_eps (not the encoder eps)
+    embeddings = build_norm(embeddings, model.mm_input_norm_w, model.mm_input_norm_b, NORM_TYPE_NORMAL, 1e-6f, -1);
+    cb(embeddings, "proj_input_norm", -1);
+
+    // 2x2 patch interleave (same as Qwen3VL) so the reshape below merges spatial 2x2 blocks
+    {
+        embeddings = ggml_cont_4d(
+            ctx0, embeddings,
+            n_embd * 2, n_patches_x / 2, n_patches_y, batch_size);
+        embeddings = ggml_reshape_4d(
+            ctx0, embeddings,
+            n_embd * 2, n_patches_x / 2, 2, batch_size * (n_patches_y / 2));
+        embeddings = ggml_permute(ctx0, embeddings, 0, 2, 1, 3);
+        embeddings = ggml_cont_3d(
+            ctx0, embeddings,
+            n_embd, n_patches_x * n_patches_y, batch_size);
+    }
+    cb(embeddings, "proj_interleaved", -1);
+
+    embeddings = ggml_reshape_3d(ctx0, embeddings, n_embd * 4, n_pos / 4, batch_size);
+
+    // projector MLP: linear_1 -> GELU (erf, as HF "gelu") -> linear_2
+    embeddings = build_ffn(embeddings,
+        model.mm_0_w, model.mm_0_b,
+        nullptr, nullptr,
+        model.mm_1_w, model.mm_1_b,
+        ffn_op_type::FFN_GELU_ERF, -1);
+
+    ggml_build_forward_expand(gf, embeddings);
+
+    return gf;
+}
