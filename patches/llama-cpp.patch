+        LOG_ERR("%s: speed must be between 0.25 and 4\n", __func__);
+        return 1;
+    }
+    for (int64_t i = 0; i < n_tok; i++) {
+        if (inp->codes[i] < 0 || inp->codes[i] >= (int32_t) tv.token_class.size()) {
