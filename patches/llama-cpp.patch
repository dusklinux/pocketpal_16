+                sa[row*NK + kc + i] = v;
+
+                kk++;
+                dx   += args.d0;
+                offk += args.d0*nb10;
+                if (++kw == args.KW) {
+                    kw    = 0;
+                    dx    = 0;
+                    dy   += args.d1;
+                    offk += args.d1*nb11 - args.KW*args.d0*nb10;
+                    if (++kh == args.KH) {
+                        kh    = 0;
+                        dy    = 0;
+                        offk += nb12 - args.KH*args.d1*nb11;
