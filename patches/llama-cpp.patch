diff --git a/vendor/llama.cpp/tools/mtmd/models/tiny-voca.cpp b/vendor/llama.cpp/tools/mtmd/models/tiny-voca.cpp
new file mode 100644
index 0000000..ab155b9
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/tiny-voca.cpp
@@ -0,0 +1,307 @@
+#include "models.h"
+#include "../mtmd-audio.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstring>
+#include <string>
+
+// same-length conv with 3 taps; x: [T, IC], w: [3, IC, OC], returns [T, OC]
+ggml_tensor * mtmd_graph_tiny_voca::conv3(ggml_tensor * x, ggml_tensor * w, ggml_tensor * b) const {
+    ggml_tensor * col = ggml_im2col(ctx0, w, x, 1, 0, 1, 0, 1, 0, false, GGML_TYPE_F32);
+    ggml_tensor * y = ggml_mul_mat(ctx0,
+            ggml_reshape_2d(ctx0, col, col->ne[0], col->ne[1] * col->ne[2]),
+            ggml_reshape_2d(ctx0, w, w->ne[0] * w->ne[1], w->ne[2]));
+    return ggml_add(ctx0, y, ggml_reshape_2d(ctx0, b, 1, b->ne[0]));
+}
+
+ggml_cgraph * mtmd_graph_tiny_voca::build() {
+    const auto & tv = model.tiny_voca;
+
+    ggml_tensor * inp = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hparams.n_embd, n_rows);
+    ggml_set_name(inp, "inp_feats");
+    ggml_set_input(inp);
+
+    ggml_tensor * cur;
+    if (gen_process == MTMD_SUBCTX_GEN_PROCESS_LATENT_IN) {
+        // duration predictor: (conv, gelu, layer norm) x 2, then a linear layer
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, inp));
+        cur = conv3(cur, tv.dur_conv1_w, tv.dur_conv1_b);
+        cur = ggml_gelu_erf(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, cur)));
+        cur = build_norm(cur, tv.dur_norm1_w, tv.dur_norm1_b, NORM_TYPE_NORMAL, eps, -1);
+        cur = conv3(ggml_cont(ctx0, ggml_transpose(ctx0, cur)), tv.dur_conv2_w, tv.dur_conv2_b);
+        cur = ggml_gelu_erf(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, cur)));
+        cur = build_norm(cur, tv.dur_norm2_w, tv.dur_norm2_b, NORM_TYPE_NORMAL, eps, -1);
+        cur = ggml_add(ctx0, build_mm(tv.dur_out_w, cur), tv.dur_out_b);
+    } else {
+        GGML_ASSERT(gen_process == MTMD_SUBCTX_GEN_PROCESS_LATENT_OUT);
+        ggml_tensor * h = ggml_add(ctx0, build_mm(tv.harm_w,  inp), tv.harm_b);
+        ggml_tensor * n = ggml_add(ctx0, build_mm(tv.noise_w, inp), tv.noise_b);
+        cur = ggml_concat(ctx0, h, n, 0);
+    }
+    ggml_set_name(cur, "out_feats");
+    ggml_set_output(cur);
+    ggml_build_forward_expand(gf, cur);
+    return gf;
+}
+
+//
+// host: harmonic plus noise synthesis, see SourceFilter in the reference (model.py)
+//
+
+// band-limited pulse train with unit power, F0 given per frame and interpolated in the log domain
+static void tiny_voca_pulse_train(const std::vector<float> & f0, std::vector<float> & out) {
+    using g = mtmd_graph_tiny_voca;
+    const int64_t n_frames = (int64_t) f0.size();
+    std::vector<double> knots(n_frames + 1);
+    for (int64_t i = 0; i < n_frames; i++) {
+        knots[i] = std::log(std::max((double) f0[i], 1.0));
+    }
+    knots[n_frames] = knots[n_frames - 1];
+
+    out.resize((size_t) (n_frames * g::hop));
+    double acc = 0.0;
+    for (int64_t n = 0; n < n_frames * g::hop; n++) {
+        const int64_t low = n / g::hop;
+        const double  w   = (double) (n - low * g::hop) / g::hop;
+        const double  freq = std::exp(knots[low] * (1.0 - w) + knots[low + 1] * w);
+        acc += freq / g::sample_rate;
+        const double theta = std::fmod(2.0 * M_PI * acc, 2.0 * M_PI);
+        const double harmonics = std::max((double) g::harmonic_limit * g::sample_rate / freq, 1.0);
+        const double whole = std::floor(harmonics);
+        const double denom = 2.0 * std::sin(theta / 2.0);
+        const double core  = std::fabs(denom) < 1e-7 ? whole : std::sin((whole + 0.5) * theta) / denom - 0.5;
+        const double wave  = core + (harmonics - whole) * std::cos((whole + 1.0) * theta);
+        out[n] = (float) (wave * std::sqrt(2.0 / harmonics));
+    }
+}
+
+// time-varying filter: STFT of the source (center, zero padding), times exp(rfft(cepstrum)) of each frame, ISTFT
+// cep(j, buf) writes the n_fft cepstrum of STFT frame j, the source gets n_fft / 2 trailing zeros first
+static void tiny_voca_filter(const std::vector<float> & src, int n_fft, int hop,
+        const std::function<void(int64_t, float *)> & cep, std::vector<float> & out) {
+    const int     n_bins = n_fft / 2 + 1;
+    const int64_t n_src  = (int64_t) src.size();
+    const int64_t n_pad  = n_src + n_fft / 2;      // length given to the STFT
+    const int64_t n_stft = 1 + n_pad / hop;        // frames, center = true
+    const int64_t n_full = n_pad + n_fft;          // with the center padding
+
+    mtmd_audio_cache cache;
+    cache.fill_sin_cos_table(n_fft);
+    cache.fill_hann_window(n_fft, true);
+    const float * win = cache.hann_window.data();
+
+    std::vector<float> x((size_t) n_full, 0.0f);
+    std::copy(src.begin(), src.end(), x.begin() + n_fft / 2);
+
+    std::vector<float> ola((size_t) n_full, 0.0f), env((size_t) n_full, 0.0f);
+    std::vector<float> fin(8 * n_fft), fout(8 * n_fft), rin(8 * n_fft), rout(8 * n_fft), cbuf(n_fft);
+    std::vector<float> resp(2 * n_bins);
+    for (int64_t j = 0; j < n_stft; j++) {
+        // response of this frame
+        std::fill(cbuf.begin(), cbuf.end(), 0.0f);
+        cep(j, cbuf.data());
+        std::copy(cbuf.begin(), cbuf.end(), rin.begin());
+        mtmd_audio_fft(cache, rin.data(), n_fft, rout.data());
+        for (int k = 0; k < n_bins; k++) {
+            const float mag = std::exp(std::clamp(rout[2 * k], -14.0f, 6.0f));
+            resp[2 * k + 0] = mag * std::cos(rout[2 * k + 1]);
+            resp[2 * k + 1] = mag * std::sin(rout[2 * k + 1]);
+        }
+
+        // spectrum of the source frame
+        const float * seg = x.data() + j * hop;
+        for (int i = 0; i < n_fft; i++) {
+            fin[i] = seg[i] * win[i];
+        }
+        mtmd_audio_fft(cache, fin.data(), n_fft, fout.data());
+
+        // filtered spectrum, mirrored for the complex inverse FFT; irfft ignores the imaginary parts of DC and Nyquist
+        for (int k = 0; k < n_bins; k++) {
+            const float a = fout[2 * k], b = fout[2 * k + 1];
+            const float c = resp[2 * k], d = resp[2 * k + 1];
+            rin[2 * k + 0] = a * c - b * d;
+            rin[2 * k + 1] = (k == 0 || k == n_fft / 2) ? 0.0f : a * d + b * c;
+        }
+        for (int k = 1; k < n_fft - n_bins + 1; k++) {
+            rin[2 * (n_fft - k) + 0] =  rin[2 * k + 0];
+            rin[2 * (n_fft - k) + 1] = -rin[2 * k + 1];
+        }
+        mtmd_audio_ifft(cache, rin.data(), n_fft, rout.data());
+
+        float * o = ola.data() + j * hop;
+        float * e = env.data() + j * hop;
+        for (int i = 0; i < n_fft; i++) {
+            o[i] += rout[2 * i] * win[i];
+            e[i] += win[i] * win[i];
+        }
+    }
+
+    out.resize((size_t) n_src);
+    for (int64_t i = 0; i < n_src; i++) {
+        const int64_t k = i + n_fft / 2; // drop the center padding
+        out[i] = env[k] > 1e-11f ? ola[k] / env[k] : 0.0f;
+    }
+}
+
+void mtmd_graph_tiny_voca::synth(const std::vector<float> & voc, const std::vector<float> & f0, std::mt19937 & rng, std::vector<float> & audio) {
+    const int64_t n_frames = (int64_t) f0.size();
+    GGML_ASSERT(n_frames > 0 && voc.size() == (size_t) (n_frames * n_voc));
+
+    // liftering: coefficient i scaled by 1 / (1 + i / 4), the gain (coefficient 0) by 2
+    auto lifter = [](int i, int first) { return i == 0 && first == 0 ? 2.0f : 1.0f / (1.0f + (float) (i + first) / 4.0f); };
+
+    // harmonic branch: envelope interpolated between frames, one gain per sub-frame
+    const int split = n_cep_causal + n_cep_anti;
+    auto harm_cep = [&](int64_t j, float * buf) {
+        const int64_t s    = std::min(j, harm_steps * n_frames - 1);
+        const float * here = voc.data() + (s / harm_steps) * n_voc;
+        const float * next = voc.data() + std::min((s + 1) / harm_steps, n_frames - 1) * n_voc;
+        for (int i = 0; i < n_cep_causal; i++) {
+            buf[i] = 0.5f * (here[i] + next[i]) * lifter(i, 0);
+        }
+        buf[0] += here[split + s % harm_steps];
+        for (int i = 0; i < n_cep_anti; i++) {
+            buf[harm_fft - 1 - i] = 0.5f * (here[n_cep_causal + i] + next[n_cep_causal + i]) * lifter(i, 1);
+        }
+    };
+    // noise branch: one envelope per frame, one gain per sub-frame
+    auto noise_cep = [&](int64_t j, float * buf) {
+        const int64_t s   = std::min(j, noise_steps * n_frames - 1);
+        const float * row = voc.data() + (s / noise_steps) * n_voc + split + harm_steps;
+        for (int i = 0; i < n_noise_cep; i++) {
+            buf[i] = row[i] * lifter(i, 0);
+        }
+        buf[0] += row[n_noise_cep + s % noise_steps];
+    };
+
+    std::vector<float> pulses, noise((size_t) (n_frames * hop)), harm_out, noise_out;
+    tiny_voca_pulse_train(f0, pulses);
+    std::normal_distribution<float> dist(0.0f, 1.0f);
+    for (auto & v : noise) {
+        v = dist(rng);
+    }
+    tiny_voca_filter(pulses, harm_fft,  harm_hop,  harm_cep,  harm_out);
+    tiny_voca_filter(noise,  noise_fft, noise_hop, noise_cep, noise_out);
+
+    audio.resize(pulses.size());
+    for (size_t i = 0; i < audio.size(); i++) {
+        audio[i] = harm_out[i] + noise_out[i];
+    }
+}
+
+//
+// host: unknown-word model of the phonemizer, see g2p.py of dizione
+//
+
+static const char * const tiny_voca_g2p_letters = "abcdefghijklmnopqrstuvwxyz'";
+static const char * const tiny_voca_g2p_symbols[mtmd_graph_tiny_voca::n_g2p_symbol] = {
+    "AA0", "AA1", "AA2", "AE0", "AE1", "AE2", "AH0", "AH1", "AH2", "AO0", "AO1", "AO2", "AW0", "AW1", "AW2", "AY0", "AY1", "AY2",
+    "B", "CH", "D", "DH", "EH0", "EH1", "EH2", "ER0", "ER1", "ER2", "EY0", "EY1", "EY2", "F", "G", "HH",
+    "IH0", "IH1", "IH2", "IY0", "IY1", "IY2", "JH", "K", "L", "M", "N", "NG", "OW0", "OW1", "OW2", "OY0", "OY1", "OY2",
+    "P", "R", "S", "SH", "T", "TH", "UH0", "UH1", "UH2", "UW0", "UW1", "UW2", "V", "W", "Y", "Z", "ZH",
+};
+
+// one direction of a GRU layer over x [n, n_in] -> y [n, n_hidden], written at column offset of rows of width stride
+// the products are summed in double and rounded once, as close as can be to the reference (numpy, float32): two
+// symbols are sometimes almost as likely, and the order of a float32 sum would decide between them
+static void tiny_voca_gru(const mtmd_tiny_voca::g2p_gru & g, const std::vector<float> & x, int64_t n, int64_t n_in, int64_t n_hidden,
+        bool reverse, std::vector<float> & y, int64_t offset, int64_t stride) {
+    const int64_t h3 = 3 * n_hidden;
+    std::vector<float> inp((size_t) (n * h3));
+    for (int64_t t = 0; t < n; t++) {
+        for (int64_t r = 0; r < h3; r++) {
+            const float * w = g.w_ih.data() + r * n_in;
+            const float * xt = x.data() + t * n_in;
+            double acc = 0.0;
+            for (int64_t c = 0; c < n_in; c++) {
+                acc += (double) w[c] * xt[c];
+            }
+            inp[t * h3 + r] = (float) acc + g.b_ih[r];
+        }
+    }
+    std::vector<float> state((size_t) n_hidden, 0.0f), rec((size_t) h3);
+    for (int64_t s = 0; s < n; s++) {
+        const int64_t t = reverse ? n - 1 - s : s;
+        for (int64_t r = 0; r < h3; r++) {
+            const float * w = g.w_hh.data() + r * n_hidden;
+            double acc = 0.0;
+            for (int64_t c = 0; c < n_hidden; c++) {
+                acc += (double) w[c] * state[c];
+            }
+            rec[r] = (float) acc + g.b_hh[r];
+        }
+        const float * in = inp.data() + t * h3;
+        for (int64_t k = 0; k < n_hidden; k++) {
+            const float reset  = 1.0f / (1.0f + std::exp(-(in[k] + rec[k])));
+            const float update = 1.0f / (1.0f + std::exp(-(in[n_hidden + k] + rec[n_hidden + k])));
+            const float cand   = std::tanh(in[2 * n_hidden + k] + reset * rec[2 * n_hidden + k]);
+            state[k] = (1.0f - update) * cand + update * state[k];
+        }
+        std::copy(state.begin(), state.end(), y.begin() + t * stride + offset);
+    }
+}
+
+std::string mtmd_graph_tiny_voca::g2p(const mtmd_tiny_voca & tv, const std::string & word) {
+    const int64_t w = tv.g2p_n_width;
+    const int64_t h = tv.g2p_n_hidden;
+    if (w == 0 || tv.g2p_layers.empty()) {
+        return "";
+    }
+    std::vector<int> ids;
+    for (char c : word) {
+        const char * p = strchr(tiny_voca_g2p_letters, std::tolower((unsigned char) c));
+        if (c != '\0' && p) {
+            ids.push_back((int) (p - tiny_voca_g2p_letters) + 1);
+        }
+    }
+    if (ids.empty()) {
+        return "";
+    }
+
+    // each letter takes n_g2p_slot positions: its embedding plus the embedding of the slot
+    const int64_t n = (int64_t) ids.size() * n_g2p_slot;
+    std::vector<float> x((size_t) (n * w));
+    for (size_t l = 0; l < ids.size(); l++) {
+        for (int s = 0; s < n_g2p_slot; s++) {
+            float * row = x.data() + ((int64_t) l * n_g2p_slot + s) * w;
+            for (int64_t c = 0; c < w; c++) {
+                row[c] = tv.g2p_embd[ids[l] * w + c] + tv.g2p_slot[s * w + c];
+            }
+        }
+    }
+    int64_t n_in = w;
+    for (size_t il = 0; il + 1 < tv.g2p_layers.size(); il += 2) {
+        std::vector<float> y((size_t) (n * 2 * h));
+        tiny_voca_gru(tv.g2p_layers[il],     x, n, n_in, h, false, y, 0, 2 * h);
+        tiny_voca_gru(tv.g2p_layers[il + 1], x, n, n_in, h, true,  y, h, 2 * h);
+        x    = std::move(y);
+        n_in = 2 * h;
+    }
+
+    // CTC, read greedily: a label repeated or the blank (0) is no new symbol
+    std::string out;
+    int prev = 0;
+    for (int64_t t = 0; t < n; t++) {
+        int best = 0;
+        float best_v = -INFINITY;
+        for (int k = 0; k <= n_g2p_symbol; k++) {
+            const float * wr = tv.g2p_out_w.data() + k * n_in;
+            double sum = 0.0;
+            for (int64_t c = 0; c < n_in; c++) {
+                sum += (double) wr[c] * x[t * n_in + c];
+            }
+            const float acc = (float) sum + tv.g2p_out_b[k];
+            if (acc > best_v) {
+                best_v = acc;
+                best   = k;
+            }
+        }
+        if (best != prev && best != 0) {
+            out += (out.empty() ? "" : " ") + std::string(tiny_voca_g2p_symbols[best - 1]);
+        }
+        prev = best;
+    }
+    return out;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/vibevoice-asr.cpp b/vendor/llama.cpp/tools/mtmd/models/vibevoice-asr.cpp
new file mode 100644
index 0000000..1158988
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/vibevoice-asr.cpp
@@ -0,0 +1,138 @@
+#include "models.h"
+
+// VibeVoice-ASR audio tower: two causal ConvNeXt pyramids (acoustic and semantic) over the raw 24 kHz waveform
+// each one is a VAE tokenizer encoder, its latents go through their own connector and the two are summed
+// see modeling_vibevoice_acoustic_tokenizer.py and modeling_vibevoice_asr.py in transformers
+//
+// tensors are T-first [T, C] around the convs and C-first [C, T] in the blocks
+
+static std::string cnx_slot(int e, const char * kind, int i) {
+    return "e" + std::to_string(e) + "_" + kind + "_" + std::to_string(i);
+}
+
+std::vector<c2w_state_slot> list_vibevoice_asr_state_slots(const mtmd_hparams & hparams, const mtmd_model & model) {
+    std::vector<c2w_state_slot> slots;
+    slots.push_back({"pos", 1, 1}); // unused, set_enc_state_in() expects it
+    const int n_stage = (int) hparams.audio_patch_sizes.size();
+    for (int e = 0; e < 2; ++e) {
+        const auto & enc = model.cnx_enc[e];
+        for (int i = 0; i <= n_stage; ++i) {
+            const int64_t stride = i < n_stage ? hparams.audio_patch_sizes[i] : 1;
+            slots.push_back({cnx_slot(e, "conv", i), enc.conv_w[i]->ne[0] - stride, enc.conv_w[i]->ne[1]});
+        }
+        for (int il = 0; il < (int) enc.blocks.size(); ++il) {
+            const auto * w = enc.blocks[il].conv_w;
+            slots.push_back({cnx_slot(e, "dw", il), w->ne[0] - 1, w->ne[1]});
+        }
+    }
+    return slots;
+}
+
+// x: [T, C] -> [left + T, C], the left context comes from the state, its new value is the tail
+ggml_tensor * mtmd_graph_vibevoice_asr::with_left_ctx(ggml_tensor * x, const std::string & name) const {
+    ggml_tensor * left = state_in.at(name);
+    x = ggml_concat(ctx0, left, x, 0);
+    state_out.push_back({name, ggml_cont(ctx0, ggml_view_2d(ctx0, x, left->ne[0], x->ne[1], x->nb[1], (x->ne[0] - left->ne[0]) * x->nb[0]))});
+    return x;
+}
+
+// x: [T, IC], w: [K, IC, OC] -> [T / stride, OC]
+ggml_tensor * mtmd_graph_vibevoice_asr::causal_conv(ggml_tensor * x, ggml_tensor * w, ggml_tensor * b, int stride, const std::string & name) const {
+    x = with_left_ctx(x, name);
+    ggml_tensor * y = ggml_conv_1d(ctx0, w, x, stride, 0, 1);
+    y = ggml_reshape_2d(ctx0, y, y->ne[0], y->ne[1]);
+    return ggml_add(ctx0, y, ggml_reshape_2d(ctx0, b, 1, b->ne[0]));
+}
+
+// x: [T, 1] -> [C_latent, T / hop]
+ggml_tensor * mtmd_graph_vibevoice_asr::encode(int e, ggml_tensor * x) const {
+    const auto & enc     = model.cnx_enc[e];
+    const int    n_stage = (int) hparams.audio_patch_sizes.size();
+
+    ggml_tensor * cur = x;
+    int bid = 0;
+    for (int stage = 0; stage < n_stage; ++stage) {
+        cur = causal_conv(cur, enc.conv_w[stage], enc.conv_b[stage], hparams.audio_patch_sizes[stage], cnx_slot(e, "conv", stage));
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+        cb(cur, "stage_in", stage);
+
+        const int64_t n_pos = cur->ne[1];
+        for (int i = 0; i < hparams.audio_depths[stage]; ++i, ++bid) {
+            const auto & layer = enc.blocks[bid];
+
+            // causal depthwise conv mixer
+            ggml_tensor * h = build_norm(cur, layer.ln_1_w, nullptr, NORM_TYPE_RMS, hparams.eps, bid);
+            h = ggml_cont(ctx0, ggml_transpose(ctx0, h));
+            h = with_left_ctx(h, cnx_slot(e, "dw", bid));
+            h = ggml_reshape_3d(ctx0, h, h->ne[0], h->ne[1], 1);
+            h = ggml_ssm_conv(ctx0, h, layer.conv_w);
+            h = ggml_reshape_2d(ctx0, h, h->ne[0], n_pos);
+            h = ggml_add(ctx0, h, layer.conv_b);
+            cur = ggml_add(ctx0, cur, ggml_mul(ctx0, h, layer.ls_1_w));
+
+            h = build_norm(cur, layer.ln_2_w, nullptr, NORM_TYPE_RMS, hparams.eps, bid);
+            h = build_ffn(h,
+                layer.ff_up_w, layer.ff_up_b,
+                nullptr, nullptr,
+                layer.ff_down_w, layer.ff_down_b,
+                FFN_GELU_ERF, bid);
+            cur = ggml_add(ctx0, cur, ggml_mul(ctx0, h, layer.ls_2_w));
+            cb(cur, "block_out", bid);
+        }
+
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    }
+
+    cur = causal_conv(cur, enc.conv_w[n_stage], enc.conv_b[n_stage], 1, cnx_slot(e, "conv", n_stage));
+    return ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+}
+
+ggml_cgraph * mtmd_graph_vibevoice_asr::build() {
+    const int64_t hop      = hparams.audio_samples_per_token();
+    const int64_t n_frames = img.nx() / hop;
+    const int64_t n_ctx    = img.audio_n_ctx / hop;
+    GGML_ASSERT(img.nx() % hop == 0 && img.audio_n_ctx % hop == 0 && n_ctx < n_frames);
+
+    for (const auto & slot : list_vibevoice_asr_state_slots(hparams, model)) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, slot.ne0, slot.ne1);
+        ggml_set_name(t, ("state_in_" + slot.name).c_str());
+        ggml_set_input(t);
+        state_in[slot.name] = t;
+    }
+    state_out.push_back({"pos", ggml_scale_bias(ctx0, state_in.at("pos"), 1.0f, (float) n_frames)});
+
+    ggml_tensor * inp = build_inp_raw(1);
+    inp = ggml_reshape_2d(ctx0, inp, img.nx(), 1);
+
+    // the leading context frames only warm up the causal convs
+    auto drop_ctx = [&](ggml_tensor * t) {
+        return ggml_view_2d(ctx0, t, t->ne[0], n_frames - n_ctx, t->nb[1], n_ctx * t->nb[1]);
+    };
+
+    // the reference adds VAE noise to the acoustic latents, skipped here to keep the output deterministic
+    ggml_tensor * acoustic = drop_ctx(encode(0, inp));
+    ggml_tensor * semantic = drop_ctx(encode(1, inp));
+    cb(acoustic, "acoustic_latents", -1);
+    cb(semantic, "semantic_latents", -1);
+
+    acoustic = ggml_add(ctx0, build_mm(model.mm_0_w, acoustic), model.mm_0_b);
+    acoustic = build_norm(acoustic, model.mm_norm_pre_w, nullptr, NORM_TYPE_RMS, 1e-6f, -1);
+    acoustic = ggml_add(ctx0, build_mm(model.mm_1_w, acoustic), model.mm_1_b);
+
+    semantic = ggml_add(ctx0, build_mm(model.mm_2_w, semantic), model.mm_2_b);
+    semantic = build_norm(semantic, model.mm_norm_mid_w, nullptr, NORM_TYPE_RMS, 1e-6f, -1);
+    semantic = ggml_add(ctx0, build_mm(model.mm_3_w, semantic), model.mm_3_b);
+
+    ggml_tensor * cur = ggml_add(ctx0, acoustic, semantic);
+    cb(cur, "projected", -1);
+
+    // the embeddings must stay the last node
+    for (const auto & s : state_out) {
+        ggml_set_name(s.second, ("state_out_" + s.first).c_str());
+        ggml_set_output(s.second);
+        ggml_build_forward_expand(gf, s.second);
+    }
+
+    ggml_build_forward_expand(gf, cur);
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/voxcpm2-gen.cpp b/vendor/llama.cpp/tools/mtmd/models/voxcpm2-gen.cpp
new file mode 100644
index 0000000..649dfb0
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/voxcpm2-gen.cpp
@@ -0,0 +1,273 @@
+#include "models.h"
+
+#include <cmath>
+
+// linspace(1, 0) with sway sampling (coef 1), see UnifiedCFM.forward()
+std::vector<float> mtmd_graph_voxcpm2_gen::t_span(int n_steps) {
+    std::vector<float> t(n_steps + 1);
+    for (int i = 0; i <= n_steps; i++) {
+        const double x = 1.0 - (double) i / n_steps;
+        t[i] = (float) (x + std::cos(M_PI / 2 * x) - 1.0 + x);
+    }
+    return t;
+}
+
+// SinusoidalPosEmb with scale 1000: [sin, cos], the frequency step divides by half - 1
+std::vector<float> mtmd_graph_voxcpm2_gen::time_embd(int n_steps, int n_embd) {
+    const std::vector<float> t = t_span(n_steps);
+    const int half = n_embd / 2;
+    std::vector<float> out((size_t) n_embd * n_steps);
+    for (int s = 0; s < n_steps; s++) {
+        for (int j = 0; j < half; j++) {
+            const double a = 1000.0 * t[s] * std::exp(-std::log(10000.0) * j / (half - 1));
+            out[(size_t) s * n_embd + j]        = (float) std::sin(a);
+            out[(size_t) s * n_embd + half + j] = (float) std::cos(a);
+        }
+    }
+    return out;
+}
+
+ggml_tensor * mtmd_graph_voxcpm2_gen::inp_pos(const char * name, int n) const {
+    ggml_tensor * pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n);
+    ggml_set_name(pos, name);
+    ggml_set_input(pos);
+    return pos;
+}
+
+ggml_tensor * mtmd_graph_voxcpm2_gen::tfm(ggml_tensor * x, const std::vector<mtmd_layer> & layers, ggml_tensor * norm_w, ggml_tensor * pos) const {
+    const int64_t n_tok     = x->ne[1];
+    const int64_t n_seq     = x->ne[2];
+    const int     n_head    = hparams.n_head;
+    const int     n_head_kv = hparams.n_head_kv;
+    const float   kq_scale  = 1.0f / sqrtf((float) head_dim);
+    ggml_tensor * factors   = model.voxcpm2.rope_factors;
+
+    for (size_t il = 0; il < layers.size(); il++) {
+        const auto & layer = layers[il];
+        ggml_tensor * cur = build_norm(x, layer.ln_1_w, nullptr, NORM_TYPE_RMS, hparams.eps, (int) il);
+
+        ggml_tensor * q = ggml_reshape_4d(ctx0, build_mm(layer.q_w, cur), head_dim, n_head,    n_tok, n_seq);
+        ggml_tensor * k = ggml_reshape_4d(ctx0, build_mm(layer.k_w, cur), head_dim, n_head_kv, n_tok, n_seq);
+        ggml_tensor * v = ggml_reshape_4d(ctx0, build_mm(layer.v_w, cur), head_dim, n_head_kv, n_tok, n_seq);
+        q = ggml_rope_ext(ctx0, q, pos, factors, head_dim, GGML_ROPE_TYPE_NEOX, rope_n_ctx_orig, rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+        k = ggml_rope_ext(ctx0, k, pos, factors, head_dim, GGML_ROPE_TYPE_NEOX, rope_n_ctx_orig, rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+
+        cur = build_attn(layer.o_w, nullptr, q, k, v, nullptr, kq_scale, (int) il);
+        x = ggml_add(ctx0, x, ggml_reshape_3d(ctx0, cur, cur->ne[0], n_tok, n_seq));
+
+        cur = build_norm(x, layer.ln_2_w, nullptr, NORM_TYPE_RMS, hparams.eps, (int) il);
+        cur = build_ffn(cur, layer.ff_up_w, nullptr, layer.ff_gate_w, nullptr, layer.ff_down_w, nullptr, FFN_SILU, (int) il);
+        x = ggml_add(ctx0, x, cur);
+    }
+    return build_norm(x, norm_w, nullptr, NORM_TYPE_RMS, hparams.eps, -1);
+}
+
+// each patch gets the special token in front, its output is the summary of the patch
+ggml_tensor * mtmd_graph_voxcpm2_gen::loc_enc(ggml_tensor * latents, int n) const {
+    const auto &  m      = model.voxcpm2;
+    const int64_t n_embd = hparams.n_embd;
+
+    ggml_tensor * x = ggml_add(ctx0, build_mm(m.enc_in_w, latents), m.enc_in_b);
+    x = ggml_reshape_3d(ctx0, x, n_embd, n_patch, n);
+    ggml_tensor * special = ggml_repeat(ctx0, ggml_reshape_3d(ctx0, m.enc_special, n_embd, 1, 1),
+                                        ggml_view_3d(ctx0, x, n_embd, 1, n, x->nb[1], x->nb[2], 0));
+    x = ggml_concat(ctx0, special, x, 1); // [n_embd, 1 + n_patch, n]
+    x = tfm(x, m.enc_layers, m.enc_norm_w, inp_pos("inp_pos_enc", 1 + n_patch));
+    x = ggml_cont(ctx0, ggml_view_2d(ctx0, x, n_embd, n, x->nb[2], 0));
+    cb(x, "loc_enc_out", -1);
+    return ggml_add(ctx0, build_mm(m.enc_to_lm_w, x), m.enc_to_lm_b);
+}
+
+void mtmd_graph_voxcpm2_gen::build_res_inp() {
+    const auto &  m      = model.voxcpm2;
+    const int64_t n_text = m.fusion_b->ne[0];
+
+    ggml_tensor * h = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_text, n_rows);
+    ggml_set_name(h, "inp_raw");
+    ggml_set_input(h);
+    ggml_tensor * x = nullptr;
+    if (audio_row) {
+        x = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_text, n_rows);
+        ggml_set_name(x, "inp_feats");
+        ggml_set_input(x);
+        // FSQ: tanh, then round to the grid of 1/9
+        ggml_tensor * q = ggml_tanh(ctx0, ggml_add(ctx0, build_mm(m.fsq_in_w, h), m.fsq_in_b));
+        q = ggml_scale(ctx0, ggml_round(ctx0, ggml_scale(ctx0, q, fsq_scale)), 1.0f / fsq_scale);
+        h = ggml_add(ctx0, build_mm(m.fsq_out_w, q), m.fsq_out_b);
+    } else {
+        x = ggml_scale(ctx0, h, 0.0f); // a text row has no input row
+    }
+
+    // logit(stop) - logit(continue), only the row of the next frame needs it
+    if (n_rows == 1) {
+        ggml_tensor * s = ggml_silu(ctx0, ggml_add(ctx0, build_mm(m.stop_proj_w, h), m.stop_proj_b));
+        s = build_mm(m.stop_head_w, s);
+        s = ggml_sub(ctx0, ggml_view_1d(ctx0, s, 1, ggml_element_size(s)), ggml_view_1d(ctx0, s, 1, 0));
+        ggml_set_name(s, "out_eos_score");
+        ggml_set_output(s);
+        ggml_build_forward_expand(gf, s);
+    }
+
+    // residual LM input rows, then the (FSQ'd) hidden states
+    ggml_tensor * r = ggml_add(ctx0, build_mm(m.fusion_w, ggml_concat(ctx0, h, x, 0)), m.fusion_b);
+    ggml_tensor * out = ggml_concat(ctx0, r, h, 1);
+    ggml_set_name(out, "out_feats");
+    ggml_set_output(out);
+    ggml_build_forward_expand(gf, out);
+}
+
+// Euler solver from noise (t = 1) to the patch (t = 0), see UnifiedCFM.solve_euler()
+void mtmd_graph_voxcpm2_gen::build_flow() {
+    const auto &  m      = model.voxcpm2;
+    const int64_t n_text = m.fusion_b->ne[0];
+    const int64_t n_embd = hparams.n_embd;
+
+    // FSQ'd hidden state, then the residual LM output
+    ggml_tensor * inp = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_text, 2);
+    ggml_set_name(inp, "inp_raw");
+    ggml_set_input(inp);
+    ggml_tensor * cond = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_latent, n_patch);
+    ggml_set_name(cond, "inp_cond");
+    ggml_set_input(cond);
+    ggml_tensor * noise = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_latent, n_patch);
+    ggml_set_name(noise, "inp_noise");
+    ggml_set_input(noise);
+    ggml_tensor * temb = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, n_steps);
+    ggml_set_name(temb, "inp_temb");
+    ggml_set_input(temb);
+    ggml_tensor * pos = inp_pos("inp_pos_dit", n_dit_tok);
+
+    ggml_tensor * mu_lm  = ggml_add(ctx0, build_mm(m.lm_to_dit_w,  ggml_view_1d(ctx0, inp, n_text, 0)),          m.lm_to_dit_b);
+    ggml_tensor * mu_res = ggml_add(ctx0, build_mm(m.res_to_dit_w, ggml_view_1d(ctx0, inp, n_text, inp->nb[1])), m.res_to_dit_b);
+    ggml_tensor * mu   = ggml_concat(ctx0, ggml_reshape_2d(ctx0, mu_lm, n_embd, 1), ggml_reshape_2d(ctx0, mu_res, n_embd, 1), 1);
+    ggml_tensor * mu_0 = ggml_scale(ctx0, mu, 0.0f); // the unconditional branch has mu = 0
+
+    temb = ggml_silu(ctx0, ggml_add(ctx0, build_mm(m.time0_w, temb), m.time0_b));
+    temb = ggml_add(ctx0, build_mm(m.time1_w, temb), m.time1_b);
+    ggml_tensor * cond_tok = ggml_add(ctx0, build_mm(m.dit_cond_w, cond), m.dit_cond_b);
+
+    const std::vector<float> t = t_span(n_steps);
+    // CFG-Zero*: the first steps keep x as is
+    const int n_zero = std::max(1, (int) ((n_steps + 1) * 0.04));
+
+    ggml_tensor * x = noise;
+    for (int s = n_zero; s < n_steps; s++) {
+        ggml_tensor * t_tok = ggml_view_2d(ctx0, temb, n_embd, 1, temb->nb[1], (size_t) s * temb->nb[1]);
+        ggml_tensor * x_tok = ggml_add(ctx0, build_mm(m.dit_in_w, x), m.dit_in_b);
+        ggml_tensor * tail  = ggml_concat(ctx0, ggml_concat(ctx0, t_tok, cond_tok, 1), x_tok, 1);
+        ggml_tensor * h = ggml_concat(ctx0,
+            ggml_reshape_3d(ctx0, ggml_concat(ctx0, mu,   tail, 1), n_embd, n_dit_tok, 1),
+            ggml_reshape_3d(ctx0, ggml_concat(ctx0, mu_0, tail, 1), n_embd, n_dit_tok, 1), 2);
+        h = tfm(h, model.layers, model.post_ln_w, pos);
+        h = ggml_cont(ctx0, ggml_view_3d(ctx0, h, n_embd, n_patch, 2, h->nb[1], h->nb[2], (size_t) (n_dit_tok - n_patch) * h->nb[1]));
+        h = ggml_add(ctx0, build_mm(m.dit_out_w, h), m.dit_out_b); // [n_latent, n_patch, 2]
+
+        // guided velocity, the unconditional one is scaled by its projection on the conditional one
+        ggml_tensor * v_c = ggml_view_2d(ctx0, h, n_latent, n_patch, h->nb[1], 0);
+        ggml_tensor * v_u = ggml_view_2d(ctx0, h, n_latent, n_patch, h->nb[1], h->nb[2]);
+        ggml_tensor * st  = ggml_div(ctx0, ggml_sum(ctx0, ggml_mul(ctx0, v_c, v_u)),
+                                           ggml_scale_bias(ctx0, ggml_sum(ctx0, ggml_sqr(ctx0, v_u)), 1.0f, 1e-8f));
+        ggml_tensor * v_s = ggml_mul(ctx0, v_u, st);
+        ggml_tensor * v   = ggml_add(ctx0, v_s, ggml_scale(ctx0, ggml_sub(ctx0, v_c, v_s), cfg_scale));
+        x = ggml_add(ctx0, x, ggml_scale(ctx0, v, t[s + 1] - t[s]));
+    }
+    GGML_ASSERT(x != noise && "voxcpm2: not enough flow steps");
+    ggml_set_name(x, "out_feats");
+    ggml_set_output(x);
+    ggml_build_forward_expand(gf, x);
+
+    // next backbone input row, the last node
+    ggml_build_forward_expand(gf, loc_enc(x, 1));
+}
+
+void mtmd_graph_voxcpm2_gen::build_latent_in() {
+    ggml_tensor * inp = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_latent, n_patch * n_rows);
+    ggml_set_name(inp, "inp_feats");
+    ggml_set_input(inp);
+    ggml_tensor * out = loc_enc(inp, n_rows);
+    ggml_set_name(out, "out_feats");
+    ggml_set_output(out);
+    ggml_build_forward_expand(gf, out);
+}
+
+std::vector<c2w_state_slot> list_voxcpm2_state_slots(const mtmd_hparams & /*hparams*/, const mtmd_model & model) {
+    const auto & m = model.voxcpm2;
+    std::vector<c2w_state_slot> slots;
+    slots.push_back({"in_dw", m.dec_in_dw_w->ne[0] - 1, m.dec_in_dw_w->ne[2]});
+    for (size_t ib = 0; ib < m.dec.size(); ib++) {
+        const auto & blk = m.dec[ib];
+        const std::string name = "up" + std::to_string(ib);
+        slots.push_back({name, blk.conv_w->ne[0] / 2, blk.conv_w->ne[1]});
+        for (size_t ir = 0; ir < blk.res.size(); ir++) {
+            const auto & ru = blk.res[ir];
+            slots.push_back({name + "_res" + std::to_string(ir),
+                             (ru.conv1_w->ne[0] - 1) * mtmd_graph_voxcpm2_gen::res_dilations[ir], ru.conv1_w->ne[2]});
+        }
+    }
+    slots.push_back({"out", m.dec_out_w->ne[0] - 1, m.dec_out_w->ne[1]});
+    return slots;
+}
+
+// causal AudioVAE decoder, the conv states carry the left context between calls
+void mtmd_graph_voxcpm2_gen::build_dec() {
+    const auto & m = model.voxcpm2;
+
+    ggml_tensor * inp = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_latent, n_patch * n_rows);
+    ggml_set_name(inp, "inp_feats");
+    ggml_set_input(inp);
+
+    mtmd_graph_qwen3tts_gen::code2wav dec(*this);
+    for (const auto & slot : list_voxcpm2_state_slots(hparams, model)) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, slot.ne0, slot.ne1);
+        ggml_set_name(t, ("state_in_" + slot.name).c_str());
+        ggml_set_input(t);
+        dec.state_in[slot.name] = t;
+    }
+
+    ggml_tensor * x = ggml_cont(ctx0, ggml_transpose(ctx0, inp)); // [T, n_latent]
+    x = dec.causal_conv1d_dw(x, m.dec_in_dw_w, m.dec_in_dw_b, "in_dw");
+    x = dec.causal_conv1d(x, m.dec_in_w, m.dec_in_b, 1, "");
+    for (size_t ib = 0; ib < m.dec.size(); ib++) {
+        const auto & blk  = m.dec[ib];
+        const std::string name = "up" + std::to_string(ib);
+        const int64_t n_ch = m.dec_sr_scale[ib]->ne[0];
+
+        // sample-rate conditioning, the row of the output rate is picked at conversion
+        x = ggml_add(ctx0, ggml_mul(ctx0, x, ggml_reshape_2d(ctx0, m.dec_sr_scale[ib], 1, n_ch)),
+                           ggml_reshape_2d(ctx0, m.dec_sr_bias[ib], 1, n_ch));
+        x = dec.snake(x, blk.snake_alpha, blk.snake_beta);
+        x = dec.causal_conv_transpose1d(x, blk.conv_w, blk.conv_b, (int) (blk.conv_w->ne[0] / 2), name);
+        for (size_t ir = 0; ir < blk.res.size(); ir++) {
+            const auto & ru = blk.res[ir];
+            ggml_tensor * h = dec.snake(x, ru.act1_alpha, ru.act1_beta);
+            h = dec.causal_conv1d_dw(h, ru.conv1_w, ru.conv1_b, name + "_res" + std::to_string(ir), res_dilations[ir]);
+            h = dec.snake(h, ru.act2_alpha, ru.act2_beta);
+            h = dec.causal_conv1d(h, ru.conv2_w, ru.conv2_b, 1, "");
+            x = ggml_add(ctx0, x, h);
+        }
+        cb(x, "vae_block", (int) ib);
+    }
+    x = dec.snake(x, m.dec_post_alpha, m.dec_post_beta);
+    x = dec.causal_conv1d(x, m.dec_out_w, m.dec_out_b, 1, "out");
+    x = ggml_tanh(ctx0, ggml_reshape_1d(ctx0, x, x->ne[0]));
+    ggml_set_name(x, "out_audio");
+    ggml_set_output(x);
+    ggml_build_forward_expand(gf, x);
+
+    for (auto & slot : dec.state_out) {
+        ggml_set_name(slot.second, ("state_out_" + slot.first).c_str());
+        ggml_set_output(slot.second);
+        ggml_build_forward_expand(gf, slot.second);
+    }
+}
+
+ggml_cgraph * mtmd_graph_voxcpm2_gen::build() {
+    switch (gen_process) {
+        case MTMD_SUBCTX_GEN_PROCESS_RES_INP:   build_res_inp();   break;
+        case MTMD_SUBCTX_GEN_PROCESS_GEN_CODE:  build_flow();      break;
+        case MTMD_SUBCTX_GEN_PROCESS_LATENT_IN: build_latent_in(); break;
+        case MTMD_SUBCTX_GEN_PROCESS_GEN_WAV:   build_dec();       break;
+        default: GGML_ABORT("voxcpm2: unknown gen_process");
+    }
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/voxcpm2-spkenc.cpp b/vendor/llama.cpp/tools/mtmd/models/voxcpm2-spkenc.cpp
new file mode 100644
index 0000000..ea5d7ef
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/voxcpm2-spkenc.cpp
@@ -0,0 +1,59 @@
+#include "models.h"
+
+ggml_tensor * mtmd_graph_voxcpm2_spkenc::conv(ggml_tensor * x, ggml_tensor * w, ggml_tensor * b, int stride, int dilation, int pad, bool depthwise) const {
+    if (pad > 0) {
+        x = ggml_pad_ext(ctx0, x, pad, 0, 0, 0, 0, 0, 0, 0);
+    }
+    // im2col in F32: the reference AudioVAE runs in FP32
+    ggml_tensor * y = nullptr;
+    if (depthwise) {
+        ggml_tensor * col = ggml_im2col(ctx0, w, ggml_reshape_4d(ctx0, x, x->ne[0], 1, x->ne[1], 1), stride, 0, 0, 0, dilation, 0, false, GGML_TYPE_F32);
+        y = ggml_mul_mat(ctx0, col, w); // [T, 1, C]
+        y = ggml_reshape_2d(ctx0, y, y->ne[0], y->ne[2]);
+    } else {
+        ggml_tensor * col = ggml_im2col(ctx0, w, x, stride, 0, 0, 0, dilation, 0, false, GGML_TYPE_F32); // [IC * K, T]
+        y = ggml_mul_mat(ctx0,
+                ggml_reshape_2d(ctx0, col, col->ne[0], col->ne[1] * col->ne[2]),
+                ggml_reshape_2d(ctx0, w, w->ne[0] * w->ne[1], w->ne[2])); // [T, OC]
+    }
+    if (b) {
+        y = ggml_add(ctx0, y, ggml_reshape_2d(ctx0, b, 1, b->ne[0]));
+    }
+    return y;
+}
+
+// causal AudioVAE encoder: waveform -> mu of the latents, 4 latents per output row
+ggml_cgraph * mtmd_graph_voxcpm2_spkenc::build() {
+    using g = mtmd_graph_voxcpm2_gen;
+    const auto & m = model.voxcpm2;
+    mtmd_graph_qwen3tts_gen::code2wav act(*this);
+
+    // the preprocessor hands over the waveform as a single-row "mel"
+    ggml_tensor * inp_raw = build_inp_raw(1);
+    ggml_tensor * x = ggml_reshape_2d(ctx0, inp_raw, inp_raw->ne[0], 1); // [T, 1]
+
+    x = conv(x, m.enc_conv_in_w, m.enc_conv_in_b, 1, 1, (int) m.enc_conv_in_w->ne[0] - 1, false);
+    for (size_t ib = 0; ib < m.enc.size(); ib++) {
+        const auto & blk = m.enc[ib];
+        for (size_t ir = 0; ir < blk.res.size(); ir++) {
+            const auto & ru  = blk.res[ir];
+            const int    dil = g::res_dilations[ir];
+            ggml_tensor * h = act.snake(x, ru.act1_alpha, ru.act1_beta);
+            h = conv(h, ru.conv1_w, ru.conv1_b, 1, dil, (int) (ru.conv1_w->ne[0] - 1) * dil, true);
+            h = act.snake(h, ru.act2_alpha, ru.act2_beta);
+            h = conv(h, ru.conv2_w, ru.conv2_b, 1, 1, 0, false);
+            x = ggml_add(ctx0, x, h);
+        }
+        x = act.snake(x, blk.snake_alpha, blk.snake_beta);
+        // kernel 2 * stride, the causal padding is one stride
+        const int stride = (int) (blk.conv_w->ne[0] / 2);
+        x = conv(x, blk.conv_w, blk.conv_b, stride, 1, stride, false);
+        cb(x, "vae_enc_block", (int) ib);
+    }
+    x = conv(x, m.enc_mu_w, m.enc_mu_b, 1, 1, (int) m.enc_mu_w->ne[0] - 1, false); // [T / hop, n_latent]
+
+    x = ggml_cont(ctx0, ggml_transpose(ctx0, x));
+    x = ggml_reshape_2d(ctx0, x, g::n_latent * g::n_patch, x->ne[1] / g::n_patch);
+    ggml_build_forward_expand(gf, x);
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/voxtral-rt.cpp b/vendor/llama.cpp/tools/mtmd/models/voxtral-rt.cpp
new file mode 100644
index 0000000..3f768d6
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/voxtral-rt.cpp
@@ -0,0 +1,111 @@
+#include "models.h"
+
+// the input holds 2 context mel frames followed by the new frames, so the causal conv stem
+// sees the same left context as on the full spectrogram
+ggml_cgraph * mtmd_graph_voxtral_rt::build() {
+    const int n_frames_in = img.nx();
+    const int n_new       = (n_frames_in - 2) / 2; // encoder frames, the conv stem has stride 2
+    const int n_window    = hparams.attn_window_size;
+    const int stack       = hparams.proj_stack_factor;
+    const int n_embd_kv   = n_head_kv * d_head;
+    const int n_ctx       = state ? state->n_ctx : n_window + n_new;
+
+    GGML_ASSERT(n_window > 0 && stack > 0);
+    GGML_ASSERT(n_new > 0 && n_new % stack == 0);
+    GGML_ASSERT(n_new <= n_ctx - n_window);
+
+    ggml_tensor * inp = build_inp_raw(1); // [n_frames_in, n_mel]
+
+    ggml_tensor * stem_tail = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, 1, n_embd);
+    ggml_set_name(stem_tail, "inp_stem_tail");
+    ggml_set_input(stem_tail);
+
+    ggml_tensor * pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_new);
+    ggml_set_name(pos, "inp_pos");
+    ggml_set_input(pos);
+
+    ggml_tensor * kv_idx = ggml_new_tensor_1d(ctx0, GGML_TYPE_I64, n_new);
+    ggml_set_name(kv_idx, "inp_kv_idx");
+    ggml_set_input(kv_idx);
+
+    ggml_tensor * kq_mask = build_inp_attn_mask(n_ctx, n_new);
+
+    // causal conv stem
+    ggml_tensor * cur = ggml_conv_1d(ctx0, model.conv1d_1_w, inp, 1, 0, 1);
+    cur = ggml_add(ctx0, cur, model.conv1d_1_b);
+    cur = ggml_gelu_erf(ctx0, cur); // [2*n_new, n_embd]
+
+    // the last frame is the left context of the second conv on the next call
+    ggml_tensor * tail = ggml_view_2d(ctx0, cur, 1, n_embd, cur->nb[1], (2*n_new - 1) * ggml_element_size(cur));
+    tail = ggml_cont(ctx0, tail);
+    ggml_set_name(tail, "out_stem_tail");
+    ggml_set_output(tail);
+    ggml_build_forward_expand(gf, tail);
+
+    cur = ggml_concat(ctx0, stem_tail, cur, 0); // [2*n_new + 1, n_embd]
+    cur = ggml_conv_1d(ctx0, model.conv1d_2_w, cur, 2, 0, 1);
+    cur = ggml_add(ctx0, cur, model.conv1d_2_b);
+    cur = ggml_gelu_erf(ctx0, cur); // [n_new, n_embd]
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur)); // [n_embd, n_new]
+    cb(cur, "after_conv1d", -1);
+
+    for (int il = 0; il < n_layer; il++) {
+        const auto & layer = model.layers[il];
+
+        ggml_tensor * x = build_norm(cur, layer.ln_1_w, nullptr, NORM_TYPE_RMS, eps, il);
+
+        ggml_tensor * q = ggml_add(ctx0, build_mm(layer.q_w, x), layer.q_b);
+        ggml_tensor * k = build_mm(layer.k_w, x);
+        ggml_tensor * v = ggml_add(ctx0, build_mm(layer.v_w, x), layer.v_b);
+
+        q = ggml_reshape_3d(ctx0, q, d_head, n_head,    n_new);
+        k = ggml_reshape_3d(ctx0, k, d_head, n_head_kv, n_new);
+
+        // interleaved rope on absolute frame positions
+        q = ggml_rope_ext(ctx0, q, pos, nullptr, d_head, GGML_ROPE_TYPE_NORMAL, 0, hparams.rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+        k = ggml_rope_ext(ctx0, k, pos, nullptr, d_head, GGML_ROPE_TYPE_NORMAL, 0, hparams.rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+        cb(q, "q", il);
+        cb(k, "k", il);
+        cb(v, "v", il);
+
+        ggml_tensor * k_cache;
+        ggml_tensor * v_cache;
+        if (state) {
+            k_cache = state->k[il];
+            v_cache = state->v[il];
+        } else {
+            k_cache = ggml_new_tensor_2d(ctx0, GGML_TYPE_F16, n_embd_kv, n_ctx);
+            v_cache = ggml_new_tensor_2d(ctx0, GGML_TYPE_F16, n_embd_kv, n_ctx);
+            ggml_set_input(k_cache);
+            ggml_set_input(v_cache);
+        }
+
+        // write the new frames into the ring, the mask selects the window out of the whole ring
+        ggml_build_forward_expand(gf, ggml_set_rows(ctx0, k_cache, ggml_reshape_2d(ctx0, k, n_embd_kv, n_new), kv_idx));
+        ggml_build_forward_expand(gf, ggml_set_rows(ctx0, v_cache, v, kv_idx));
+
+        ggml_tensor * k_all = ggml_reshape_3d(ctx0, k_cache, d_head, n_head_kv, n_ctx);
+        ggml_tensor * v_all = ggml_reshape_3d(ctx0, v_cache, d_head, n_head_kv, n_ctx);
+
+        x = build_attn(layer.o_w, layer.o_b, q, k_all, v_all, kq_mask, kq_scale, il);
+        cur = ggml_add(ctx0, cur, x);
+
+        x = build_norm(cur, layer.ln_2_w, nullptr, NORM_TYPE_RMS, eps, il);
+        x = build_ffn(x, layer.ff_up_w, nullptr, layer.ff_gate_w, nullptr, layer.ff_down_w, layer.ff_down_b, hparams.ffn_op, il);
+        cur = ggml_add(ctx0, cur, x);
+        cb(cur, "layer_out", il);
+    }
+
+    cur = build_norm(cur, model.post_ln_w, nullptr, NORM_TYPE_RMS, eps, -1);
+    cb(cur, "after_transformer", -1);
+
+    cur = build_stack(cur, stack, n_embd);
+    cur = build_mm(model.mm_1_w, cur);
+    cur = ggml_gelu_erf(ctx0, cur);
+    cur = build_mm(model.mm_2_w, cur);
+    cb(cur, "projected", -1);
+
+    ggml_build_forward_expand(gf, cur);
+
+    return gf;
+}
