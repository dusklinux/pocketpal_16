+// the halves 1024 + q for integers q < 1024: exact normal values, unlike the subnormal q*2^-24 that Metal may flush to zero
+inline half2 mul_mv_mma_1024_plus(ushort2 q) {
+    return as_type<half2>(q | mma_f16_1024_bits);
