-            sp.top_k          = samp_topk > 0 ? samp_topk : 0;
-            sp.top_p          = (samp_topp > 0.0f && samp_topp < 1.0f) ? samp_topp : 1.0f;
-            sp.min_p          = 0.0f;
-            sp.penalty_repeat = 1.0f;
-            sp.penalty_last_n = 0;
-            sp.penalty_freq   = 0.0f;
-            sp.penalty_present = 0.0f;
