-static std::string build_neutts_codes_string(const std::vector<int32_t> &codes) {
-    std::string out;
-    out.reserve(codes.size() * 16);
-    for (int32_t c : codes) {
-        out += "<|speech_";
-        out += std::to_string(c);
-        out += "|>";
-    }
-    return out;
-}
