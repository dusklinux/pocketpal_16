diff --git a/vendor/llama.cpp/tools/mtmd/models/muse-spark-audio.cpp b/vendor/llama.cpp/tools/mtmd/models/muse-spark-audio.cpp
new file mode 100644
index 0000000..20e770e
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/muse-spark-audio.cpp
@@ -0,0 +1,66 @@
+#include "models.h"
+
+// Muse Spark audio tower: a causal conv pyramid over the raw waveform, no attention and no spectrogram
+// each stage folds `patch` samples into the channel dim, projects, then runs `depth` residual blocks (depthwise causal conv, RMS norm, GELU MLP)
+ggml_cgraph * mtmd_graph_muse_spark_audio::build() {
+    const int kernel = hparams.audio_conv_kernel_size;
+    const int n_stage = (int) hparams.audio_patch_sizes.size();
+
+    // shape [1, n_samples], so the first stage folds the same way as the others
+    ggml_tensor * cur = build_inp_raw(1);
+    cur = ggml_reshape_2d(ctx0, cur, 1, img.nx());
+    cb(cur, "inp_raw", -1);
+
+    int bid = 0;
+    for (int stage = 0; stage < n_stage; ++stage) {
+        const int patch = hparams.audio_patch_sizes[stage];
+        const auto & pe = model.a_patches[stage];
+
+        // fold `patch` positions into the channel dim
+        cur = ggml_reshape_2d(ctx0, cur, cur->ne[0] * patch, cur->ne[1] / patch);
+        cb(cur, "patch_folded", stage);
+
+        GGML_ASSERT(pe.proj_w->ne[1] == hparams.audio_hidden_sizes[stage]);
+        cur = ggml_mul_mat(ctx0, pe.proj_w, cur);
+        cur = ggml_add(ctx0, cur, pe.proj_b);
+        cur = build_norm(cur, pe.norm_w, nullptr, NORM_TYPE_RMS, hparams.eps, stage);
+        cb(cur, "patch_embd", stage);
+
+        for (int i = 0; i < hparams.audio_depths[stage]; ++i, ++bid) {
+            const auto & layer = model.layers[bid];
+            ggml_tensor * residual = cur;
+
+            // depthwise conv over time, pad on the left so it is causal
+            ggml_tensor * conv = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+            conv = ggml_pad_ext(ctx0, conv, kernel - 1, 0, 0, 0, 0, 0, 0, 0);
+            conv = ggml_conv_1d_dw(ctx0, layer.conv_w, conv, 1, 0, 1);
+            conv = ggml_cont(ctx0, ggml_transpose(ctx0, conv));
+            conv = ggml_add(ctx0, conv, layer.conv_b);
+            cb(conv, "conv", bid);
+
+            cur = build_norm(conv, layer.conv_norm_w, nullptr, NORM_TYPE_RMS, hparams.eps, bid);
+
+            cur = build_ffn(cur,
+                layer.ff_up_w, layer.ff_up_b,
+                nullptr, nullptr,
+                layer.ff_down_w, layer.ff_down_b,
+                FFN_GELU_ERF, bid);
+            cb(cur, "ffn_out", bid);
+
+            cur = ggml_add(ctx0, cur, residual);
+            cb(cur, "block_out", bid);
+        }
+    }
+
+    cur = build_norm(cur, model.pre_ln_w, nullptr, NORM_TYPE_RMS, hparams.eps, -1);
+    cb(cur, "enc_norm", -1);
+
+    // straight into the text hidden size, no adapter
+    cur = ggml_mul_mat(ctx0, model.mm_fc_w, cur);
+    cur = ggml_add(ctx0, cur, model.mm_fc_b);
+    cur = build_norm(cur, model.post_ln_w, nullptr, NORM_TYPE_RMS, hparams.eps, -1);
+    cb(cur, "projected", -1);
+
+    ggml_build_forward_expand(gf, cur);
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/music3-gen.cpp b/vendor/llama.cpp/tools/mtmd/models/music3-gen.cpp
new file mode 100644
index 0000000..2cdd82b
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/music3-gen.cpp
@@ -0,0 +1,224 @@
+#include "models.h"
+
+#include <cmath>
+
+// latent frames of a window of n_frames, see MiniMaxMusic3ConditionEncoder of the reference
+int64_t mtmd_graph_music3_gen::latent_frames(int64_t n_frames) {
+    const double n = (double) n_frames * 44100.0 / 24000.0 * 960.0 / 512.0;
+    return std::max<int64_t>(1, (int64_t) n);
+}
+
+// one frame of the depth decoder (RVQDepthDecoder): row 0 is the backbone hidden, row p > 0 the embedding of code p - 1
+// each step reruns the 4 layers over the rows so far (at most 8, no KV cache), like the reference
+ggml_cgraph * mtmd_graph_music3_gen::build_depth() {
+    const int64_t n_cb  = model.gen_code_head_w->ne[2]; // residual codebooks
+    const int64_t n_voc = model.gen_code_head_w->ne[1];
+    const int64_t B     = n_rows; // cond, then uncond with guidance
+
+    ggml_tensor * inp_h = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, B);
+    ggml_set_name(inp_h, "inp_feats");
+    ggml_set_input(inp_h);
+
+    ggml_tensor * code0 = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, 1);
+    ggml_set_name(code0, "inp_code0");
+    ggml_set_input(code0);
+
+    ggml_tensor * inp_rand = ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, n_cb);
+    ggml_set_name(inp_rand, "inp_rand");
+    ggml_set_input(inp_rand);
+
+    mtmd_graph_qwen3tts_gen::code_gen cg(*this, top_k, 1.0f);
+
+    // [n_embd, 1, B], the codes are the same in all rows
+    auto project = [&](ggml_tensor * x) {
+        ggml_tensor * y = build_mm(model.gen_code_proj_in_w, x);
+        y = ggml_reshape_3d(ctx0, y, n_embd, 1, y->ne[1]);
+        return y->ne[2] == B ? y : ggml_repeat_4d(ctx0, y, n_embd, 1, B, 1);
+    };
+
+    ggml_tensor * e0  = ggml_get_rows(ctx0, model.gen_code_out_embd_w, code0);
+    ggml_tensor * seq = ggml_concat(ctx0, project(inp_h), project(e0), 1);
+
+    ggml_tensor * out_codes = code0;
+    ggml_tensor * hiddens   = ggml_view_2d(ctx0, inp_h, n_embd, 1, inp_h->nb[1], 0); // cond row of each step
+    ggml_tensor * embd_sum  = e0;
+
+    for (int64_t g = 0; g < n_cb; g++) {
+        const int64_t n_pos = g + 2;
+
+        ggml_tensor * ones = ggml_fill(ctx0, ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_pos, n_pos), 1.0f);
+        build_vit_opts opts;
+        opts.attn_mask = ggml_log(ctx0, ggml_tri(ctx0, ones, GGML_TRI_TYPE_LOWER_DIAG)); // 0 = keep, -inf = masked
+        if (flash_attn_type == MTMD_FLASH_ATTN_TYPE_ENABLED) {
+            opts.attn_mask = ggml_cast(ctx0, opts.attn_mask, GGML_TYPE_F16);
+        }
+        ggml_tensor * pos = ggml_view_2d(ctx0, model.position_embeddings, n_embd, n_pos, model.position_embeddings->nb[1], 0);
+
+        ggml_tensor * out  = build_vit(seq, n_pos, NORM_TYPE_RMS, FFN_SILU, pos, nullptr, opts); // [n_embd, n_pos, B]
+        ggml_tensor * last = ggml_cont(ctx0, ggml_view_2d(ctx0, out, n_embd, B, out->nb[2], (n_pos - 1) * out->nb[1]));
+        hiddens = ggml_concat(ctx0, hiddens, ggml_view_2d(ctx0, last, n_embd, 1, last->nb[1], 0), 1);
+
+        ggml_tensor * head = ggml_view_2d(ctx0, model.gen_code_head_w, n_embd, n_voc, model.gen_code_head_w->nb[1], g * model.gen_code_head_w->nb[2]);
+        ggml_tensor * logits = ggml_mul_mat(ctx0, head, last); // [n_voc, B]
+        if (B > 1) {
+            ggml_tensor * cond   = ggml_view_1d(ctx0, logits, n_voc, 0);
+            ggml_tensor * uncond = ggml_view_1d(ctx0, logits, n_voc, logits->nb[1]);
+            logits = ggml_add(ctx0, uncond, ggml_scale(ctx0, ggml_sub(ctx0, cond, uncond), cfg_scale));
+        }
+
+        ggml_tensor * code;
+        if (temp > 0.0f) {
+            ggml_tensor * rnd = ggml_view_1d(ctx0, inp_rand, 1, g * inp_rand->nb[0]);
+            code = cg.do_sampling(ggml_scale(ctx0, logits, 1.0f / temp), rnd);
+        } else {
+            code = ggml_argmax(ctx0, logits);
+        }
+        code = ggml_reshape_1d(ctx0, code, 1);
+        out_codes = ggml_concat(ctx0, out_codes, code, 0);
+
+        ggml_tensor * table = ggml_view_2d(ctx0, model.gen_code_embd_w, n_embd, n_voc, model.gen_code_embd_w->nb[1], g * model.gen_code_embd_w->nb[2]);
+        ggml_tensor * e = ggml_get_rows(ctx0, table, code);
+        embd_sum = ggml_add(ctx0, embd_sum, e);
+        if (g + 1 < n_cb) {
+            seq = ggml_concat(ctx0, seq, project(e), 1);
+        }
+    }
+
+    ggml_set_name(out_codes, "out_codes");
+    ggml_set_output(out_codes);
+    ggml_build_forward_expand(gf, out_codes);
+
+    // condition row of the frame: the 8 hidden states mixed by the condition encoder weights
+    ggml_tensor * cond_row = ggml_mul_mat(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, hiddens)), model.music3.cond_layer_w);
+    ggml_set_name(cond_row, "out_feats");
+    ggml_set_output(cond_row);
+    ggml_build_forward_expand(gf, cond_row);
+
+    // backbone input of the next frame: (E_lm[semantic] + sum of E_cb[g][code g]) / sqrt(n_cb + 1), must be the last node
+    ggml_tensor * out_embd = ggml_scale(ctx0, embd_sum, 1.0f / sqrtf((float) (n_cb + 1)));
+    cb(out_embd, "gen_audio_out", -1);
+    ggml_build_forward_expand(gf, out_embd);
+    return gf;
+}
+
+// frame rows [n_embd, n_rows] -> conv k = 3 -> nearest resampling to n_out latent frames
+ggml_cgraph * mtmd_graph_music3_gen::build_cond() {
+    const auto & m = model.music3;
+
+    ggml_tensor * inp = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, n_rows);
+    ggml_set_name(inp, "inp_feats");
+    ggml_set_input(inp);
+
+    ggml_tensor * idx = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_out);
+    ggml_set_name(idx, "inp_idx");
+    ggml_set_input(idx);
+
+    ggml_tensor * x = ggml_cont(ctx0, ggml_transpose(ctx0, inp)); // [T, n_embd]
+    x = conv1d(x, m.cond_w, m.cond_b, 1);
+    x = ggml_cont(ctx0, ggml_transpose(ctx0, x)); // [n_cond, T]
+    x = ggml_get_rows(ctx0, x, idx);
+    ggml_set_name(x, "out_feats");
+    ggml_set_output(x);
+    ggml_build_forward_expand(gf, x);
+    return gf;
+}
+
+// one velocity pass of the DiT over a window, the cond and uncond (zero condition) inputs as a batch of 2
+// the input rows are [latent, zeros, condition], the time embedding is prepended as one extra token
+ggml_cgraph * mtmd_graph_music3_gen::build_dit() {
+    const auto & m = model.music3;
+    const int64_t n_in    = m.pre_w->ne[0];
+    const int64_t n_dit   = m.proj_in_w->ne[1];
+    const int64_t n_head  = n_dit / dit_d_head;
+    const int64_t n_pos   = n_rows + 1;
+    const int64_t B       = 2;
+
+    ggml_tensor * inp = ggml_new_tensor_3d(ctx0, GGML_TYPE_F32, n_in, n_rows, B);
+    ggml_set_name(inp, "inp_feats");
+    ggml_set_input(inp);
+
+    ggml_tensor * inp_t = ggml_new_tensor_1d(ctx0, GGML_TYPE_F32, 1);
+    ggml_set_name(inp_t, "inp_t");
+    ggml_set_input(inp_t);
+
+    ggml_tensor * x = ggml_add(ctx0, inp, build_mm(m.pre_w, inp));
+    x = build_mm(m.proj_in_w, x); // [n_dit, n_rows, B]
+
+    // time token: Fourier features -> linear -> silu -> linear
+    ggml_tensor * ang  = ggml_mul(ctx0, m.time_freq, inp_t);
+    ggml_tensor * temb = ggml_concat(ctx0, ggml_cos(ctx0, ang), ggml_sin(ctx0, ang), 0);
+    temb = ggml_silu(ctx0, ggml_add(ctx0, build_mm(m.time_in_w, temb), m.time_in_b));
+    temb = ggml_add(ctx0, build_mm(m.time_out_w, temb), m.time_out_b);
+    temb = ggml_repeat_4d(ctx0, ggml_reshape_3d(ctx0, temb, n_dit, 1, 1), n_dit, 1, B, 1);
+    x = ggml_concat(ctx0, temb, x, 1); // [n_dit, n_pos, B]
+    x = ggml_reshape_2d(ctx0, x, n_dit, n_pos * B);
+
+    ggml_tensor * pos = ggml_cast(ctx0, ggml_arange(ctx0, 0.0f, (float) n_pos, 1.0f), GGML_TYPE_I32);
+    const float kq = 1.0f / sqrtf((float) dit_d_head);
+
+    for (size_t il = 0; il < m.dit.size(); il++) {
+        const auto & layer = m.dit[il];
+
+        ggml_tensor * h = build_norm(x, layer.ln_1_w, layer.ln_1_b, NORM_TYPE_NORMAL, dit_eps, (int) il);
+        ggml_tensor * q = ggml_reshape_4d(ctx0, build_mm(layer.q_w, h), dit_d_head, n_head, n_pos, B);
+        ggml_tensor * k = ggml_reshape_4d(ctx0, build_mm(layer.k_w, h), dit_d_head, n_head, n_pos, B);
+        ggml_tensor * v = ggml_reshape_4d(ctx0, build_mm(layer.v_w, h), dit_d_head, n_head, n_pos, B);
+
+        // only the first dit_n_rot dims of each head rotate
+        q = ggml_rope_ext(ctx0, q, pos, nullptr, dit_n_rot, GGML_ROPE_TYPE_NEOX, 0, dit_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+        k = ggml_rope_ext(ctx0, k, pos, nullptr, dit_n_rot, GGML_ROPE_TYPE_NEOX, 0, dit_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+
+        x = ggml_add(ctx0, x, build_attn(layer.o_w, nullptr, q, k, v, nullptr, kq, (int) il));
+
+        h = build_norm(x, layer.ln_2_w, layer.ln_2_b, NORM_TYPE_NORMAL, dit_eps, (int) il);
+        h = build_ffn(h, layer.ff_up_w, layer.ff_up_b, layer.ff_gate_w, layer.ff_gate_b, layer.ff_down_w, layer.ff_down_b, FFN_SILU, (int) il);
+        x = ggml_add(ctx0, x, h);
+    }
+
+    // drop the time token
+    x = ggml_reshape_3d(ctx0, x, n_dit, n_pos, B);
+    x = ggml_view_3d(ctx0, x, n_dit, n_rows, B, x->nb[1], x->nb[2], x->nb[1]);
+    x = build_mm(m.proj_out_w, ggml_cont(ctx0, x));
+    x = ggml_add(ctx0, x, build_mm(m.post_w, x)); // [n_latent, n_rows, B]
+
+    // classifier-free guidance
+    ggml_tensor * cond   = ggml_view_2d(ctx0, x, n_latent, n_rows, x->nb[1], 0);
+    ggml_tensor * uncond = ggml_view_2d(ctx0, x, n_latent, n_rows, x->nb[1], x->nb[2]);
+    x = ggml_add(ctx0, uncond, ggml_scale(ctx0, ggml_sub(ctx0, cond, uncond), cfg_scale));
+    ggml_set_name(x, "out_feats");
+    ggml_set_output(x);
+    ggml_build_forward_expand(gf, x);
+    return gf;
+}
+
+// the two channels are decoded as two mono streams of n_latent / 2 channels, then tanh
+ggml_cgraph * mtmd_graph_music3_gen::build_vocoder() {
+    ggml_tensor * inp = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_latent, n_rows);
+    ggml_set_name(inp, "inp_feats");
+    ggml_set_input(inp);
+
+    ggml_tensor * x = ggml_cont(ctx0, ggml_transpose(ctx0, inp)); // [T, n_latent]
+    const int64_t n_half = n_latent / n_channels;
+    ggml_tensor * out = nullptr;
+    for (int c = 0; c < n_channels; c++) {
+        ggml_tensor * xc = ggml_cont(ctx0, ggml_view_2d(ctx0, x, n_rows, n_half, x->nb[1], c * n_half * x->nb[1]));
+        ggml_tensor * y  = ggml_tanh(ctx0, build_snake_vae(xc, model.snake_vae)); // [T * ratio, 1]
+        out = out ? ggml_concat(ctx0, out, y, 1) : y;
+    }
+
+    out = ggml_cont(ctx0, ggml_transpose(ctx0, out)); // interleaved
+    ggml_set_name(out, "out_audio");
+    ggml_set_output(out);
+    ggml_build_forward_expand(gf, out);
+    return gf;
+}
+
+ggml_cgraph * mtmd_graph_music3_gen::build() {
+    switch (gen_process) {
+        case MTMD_SUBCTX_GEN_PROCESS_GEN_CODE:  return build_depth();
+        case MTMD_SUBCTX_GEN_PROCESS_FLOW_COND: return build_cond();
+        case MTMD_SUBCTX_GEN_PROCESS_FLOW_STEP: return build_dit();
+        case MTMD_SUBCTX_GEN_PROCESS_GEN_WAV:   return build_vocoder();
+        default: GGML_ABORT("minimax_music3: unsupported gen process");
+    }
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/nemotron-omni.cpp b/vendor/llama.cpp/tools/mtmd/models/nemotron-omni.cpp
new file mode 100644
index 0000000..fc0f2b2
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/nemotron-omni.cpp
@@ -0,0 +1,56 @@
+#include "models.h"
+
+ggml_tensor * mtmd_graph_nemotron_omni::build_inp_with_temporal_merge() {
+    if (n_batch == 1 && !img_batch->is_video) {
+        return build_inp();
+    }
+
+    GGML_ASSERT(n_batch == 1 || n_batch == 2);
+    GGML_ASSERT(model.patch_embeddings_1 != nullptr);
+    GGML_ASSERT(model.patch_embeddings_1->ne[2] == 6);
+
+    ggml_tensor * inp_raw = build_inp_raw();
+    if (n_batch == 1) {
+        // pad the last video frame inside the graph
+        inp_raw = ggml_concat(ctx0, inp_raw, inp_raw, 2);
+    } else {
+        inp_raw = ggml_reshape_4d(ctx0, inp_raw, img.nx(), img.ny(), 6, 1);
+    }
+
+    ggml_tensor * inp = ggml_conv_2d(ctx0, model.patch_embeddings_1, inp_raw, patch_size, patch_size, 0, 0, 1, 1);
+    inp = ggml_reshape_3d(ctx0, inp, n_patches, n_embd, 1);
+    return ggml_cont(ctx0, ggml_transpose(ctx0, inp));
+}
+
+ggml_cgraph * mtmd_graph_nemotron_omni::build() {
+    GGML_ASSERT(model.class_embedding != nullptr);
+    GGML_ASSERT(model.position_embeddings != nullptr);
+
+    const int n_registers = model.class_embedding->ne[1];
+    const int n_pos = n_patches + n_registers;
+
+    ggml_tensor * inp = build_inp_with_temporal_merge();
+
+    inp = ggml_add(ctx0, inp, resize_position_embeddings(GGML_SCALE_MODE_BILINEAR));
+    cb(inp, "inp_pos", -1);
+
+    inp = ggml_concat(ctx0, model.class_embedding, inp, 1);
+
+    ggml_tensor * cur = build_vit(inp, n_pos, NORM_TYPE_NORMAL, hparams.ffn_op, nullptr, nullptr);
+
+    cur = ggml_view_2d(ctx0, cur,
+        n_embd, n_patches,
+        ggml_row_size(cur->type, n_embd),
+        n_registers * ggml_row_size(cur->type, n_embd));
+
+    cur = build_patch_merge_permute(cur, model.hparams.n_merge);
+
+    {
+        cur = build_norm(cur, model.mm_0_w, nullptr, NORM_TYPE_RMS, 1e-5, -1);
+        cur = build_ffn(cur, model.mm_1_w, nullptr, nullptr, nullptr, model.mm_3_w, nullptr, FFN_RELU_SQR, -1);
+    }
+
+    ggml_build_forward_expand(gf, cur);
+
+    return gf;
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/nemotron-transcribe.cpp b/vendor/llama.cpp/tools/mtmd/models/nemotron-transcribe.cpp
new file mode 100644
index 0000000..b8fe377
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/nemotron-transcribe.cpp
@@ -0,0 +1,343 @@
+#include "models.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <numeric>
+
+// NeMo ParallelExpertEncoder: ASR and speaker (Sortformer) transformers, speaker activity fused into the ASR states
+
+// a speaker is active in an 80 ms frame where its prediction exceeds this (speaker_activity_threshold)
+static constexpr float SPK_ACTIVITY_THR = 0.5f;
+
+// NeMo streaming Sortformer: PEE online defaults and the checkpoint's sortformer_modules config
+static constexpr int   SPK_FIFO_LEN          = 40;
+static constexpr int   SPK_CACHE_LEN         = 188;
+static constexpr int   SPK_SIL_FRAMES        = 1;
+static constexpr float SPK_PRED_SCORE_THR    = 0.25f;
+static constexpr float SPK_BOOST_LATEST      = 0.05f;
+static constexpr float SPK_STRONG_BOOST_RATE = 0.75f;
+static constexpr float SPK_WEAK_BOOST_RATE   = 1.5f;
+static constexpr float SPK_MIN_POS_RATE      = 0.5f;
+
+// _compress_spkcache runs here on exp(score): its additive log terms become factors and -inf becomes 0
+static constexpr float SPK_SCORE_OFFSET = 2.0f; // -log(0.5) in _get_log_pred_scores
+static constexpr float SPK_STRONG_BOOST = 4.0f; // _boost_topk_scores, scale_factor 2
+static constexpr float SPK_WEAK_BOOST   = 2.0f; // _boost_topk_scores, scale_factor 1
+static constexpr float SPK_SPEECH_THR   = 0.5f; // _disable_low_scores: a speaker's frames at or below it are not cached
+
+// the speaker expert has its own layers, width and head count, which build_vit does not take; full rotary
+ggml_tensor * mtmd_graph_nemotron_transcribe::build_spk_encoder(ggml_tensor * cur, ggml_tensor * pos) {
+    const int     n_head = hparams.spk_n_head;
+    const int64_t n_embd = cur->ne[0];
+    const int64_t n_pos  = cur->ne[1];
+    const int64_t d_head = n_embd / n_head;
+
+    cur = build_norm(cur, model.spk_pre_ln_w, model.spk_pre_ln_b, NORM_TYPE_NORMAL, eps, -1);
+    for (int il = 0; il < (int) model.spk_layers.size(); il++) {
+        const auto & layer = model.spk_layers[il];
+        ggml_tensor * x = build_norm(cur, layer.ln_1_w, layer.ln_1_b, NORM_TYPE_NORMAL, eps, il);
+
+        ggml_tensor * qkv = build_mm(layer.qkv_w, x);
+        const size_t es = ggml_element_size(qkv);
+        ggml_tensor * q = ggml_view_3d(ctx0, qkv, d_head, n_head, n_pos, d_head * es, qkv->nb[1], 0);
+        ggml_tensor * k = ggml_view_3d(ctx0, qkv, d_head, n_head, n_pos, d_head * es, qkv->nb[1], n_embd * es);
+        ggml_tensor * v = ggml_view_3d(ctx0, qkv, d_head, n_head, n_pos, d_head * es, qkv->nb[1], 2 * n_embd * es);
+        q = ggml_rope_ext(ctx0, q, pos, nullptr, d_head, GGML_ROPE_TYPE_NEOX, 0, 10000.0f, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+        k = ggml_rope_ext(ctx0, k, pos, nullptr, d_head, GGML_ROPE_TYPE_NEOX, 0, 10000.0f, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+
+        x = build_attn(layer.o_w, layer.o_b, q, k, v, nullptr, 1.0f / sqrtf((float) d_head), il);
+        cur = ggml_add(ctx0, cur, x);
+
+        x = build_norm(cur, layer.ln_2_w, layer.ln_2_b, NORM_TYPE_NORMAL, eps, il);
+        x = build_ffn(x, layer.ff_up_w, layer.ff_up_b, nullptr, nullptr, layer.ff_down_w, layer.ff_down_b, FFN_GELU_ERF, il);
+        cur = ggml_add(ctx0, cur, x);
+    }
+
+    return build_norm(cur, model.spk_post_ln_w, model.spk_post_ln_b, NORM_TYPE_NORMAL, eps, -1);
+}
+
+ggml_cgraph * mtmd_graph_nemotron_transcribe::build() {
+    const int     sub          = hparams.subsampling_factor;
+    const int64_t n_mel        = hparams.n_mel_bins;
+    const int64_t n_mel_frames = img.nx();
+    const int64_t n_pos        = (n_mel_frames + sub - 1) / sub;
+    GGML_ASSERT(img.ny() == n_mel);
+
+    // warmup: the largest graph, with a full speaker cache and FIFO
+    const int64_t n_prev = state == nullptr ? SPK_CACHE_LEN + SPK_FIFO_LEN
+        : (int64_t) state->spk_prev.size() / hparams.spk_n_embd;
+
+    // [n_frames, n_mel] log-mel: raw for the speaker expert, normalized over the recording (encode_windows) for the ASR one
+    ggml_tensor * inp = build_inp_raw(1);
+    ggml_tensor * inp_norm = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_mel_frames, n_mel);
+    ggml_set_name(inp_norm, "inp_norm");
+    ggml_set_input(inp_norm);
+    auto stack_mel = [&](ggml_tensor * mel) {
+        return build_stack(ggml_cont(ctx0, ggml_transpose(ctx0, mel)), sub, n_mel);
+    };
+
+    // positions over [cache | FIFO | window]; the ASR expert takes the first n_pos
+    ggml_tensor * pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_prev + n_pos);
+    ggml_set_name(pos, "positions");
+    ggml_set_input(pos);
+
+    ggml_tensor * spk_prev = nullptr;
+    if (n_prev > 0) {
+        spk_prev = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, hparams.spk_n_embd, n_prev);
+        ggml_set_name(spk_prev, "spk_prev");
+        ggml_set_input(spk_prev);
+    }
+
+    ggml_tensor * asr_pos = ggml_view_1d(ctx0, pos, n_pos, 0);
+    auto add_pos = [&](ggml_tensor * cur, const mtmd_layer &) {
+        return ggml_rope_ext(ctx0, cur, asr_pos, nullptr, hparams.audio_rope_dims, GGML_ROPE_TYPE_NEOX, 0, 10000.0f, 1.0f,
+                             0.0f, 1.0f, 0.0f, 0.0f);
+    };
+    ggml_tensor * asr = build_vit(build_mm(model.inp_proj_w, stack_mel(inp_norm)), n_pos, NORM_TYPE_NORMAL, FFN_GELU_ERF, nullptr,
+                                  add_pos);
+    cb(asr, "asr_out", -1);
+
+    // speaker expert over [cache | FIFO | window]; the window's rows and predictions feed the next window's state
+    ggml_tensor * chunk = build_mm(model.spk_inp_proj_w, stack_mel(inp));
+    ggml_set_name(chunk, "spk_chunk");
+    ggml_set_output(chunk);
+    ggml_tensor * spk = spk_prev ? ggml_concat(ctx0, spk_prev, chunk, 1) : chunk;
+    const int64_t n_spk_pos = n_prev + n_pos;
+    spk = build_spk_encoder(spk, pos);
+    cb(spk, "spk_out", -1);
+
+    // Sortformer head, 10 ms frames
+    ggml_tensor * cur = ggml_add(ctx0, build_mm(model.spk_head_proj_w, spk), model.spk_head_proj_b);
+    const int64_t d_tf = cur->ne[0];
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    cur = ggml_conv_1d(ctx0, model.spk_head_up_w, cur, 1, 1, 1);                            // [n_spk_pos, sub*d_tf]
+    cur = ggml_add(ctx0, cur, ggml_reshape_2d(ctx0, model.spk_head_up_b, 1, sub * d_tf));
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    cur = ggml_reshape_2d(ctx0, cur, d_tf, sub * n_spk_pos);
+    cur = ggml_add(ctx0, build_mm(model.spk_head_fc1_w, ggml_relu(ctx0, cur)), model.spk_head_fc1_b);
+    cur = ggml_add(ctx0, build_mm(model.spk_head_fc2_w, ggml_relu(ctx0, cur)), model.spk_head_fc2_b);
+    ggml_tensor * probs = ggml_sigmoid(ctx0, cur);                                          // [n_spk, sub*n_spk_pos]
+    cb(probs, "spk_probs", -1);
+
+    // 80 ms predictions
+    ggml_tensor * preds = ggml_pool_2d(ctx0, probs, GGML_OP_POOL_AVG, 1, sub, 1, sub, 0, 0);  // [n_spk, n_spk_pos]
+    ggml_set_name(preds, "spk_preds");
+    ggml_set_output(preds);
+
+    // fusion, on the window's rows
+    preds = ggml_view_2d(ctx0, preds, preds->ne[0], n_pos, preds->nb[1], n_prev * preds->nb[1]);
+    ggml_tensor * act = ggml_step(ctx0, ggml_scale_bias(ctx0, preds, 1.0f, -SPK_ACTIVITY_THR));
+    act = build_norm(act, model.fusion_spk_norm_w, model.fusion_spk_norm_b, NORM_TYPE_NORMAL, eps, -1);
+    cur = build_norm(asr, model.fusion_asr_norm_w, model.fusion_asr_norm_b, NORM_TYPE_NORMAL, eps, -1);
+    cur = ggml_add(ctx0, cur, build_mm(model.fusion_spk_kernel, act));
+    cb(cur, "fused", -1);
+
+    cur = ggml_add(ctx0, build_mm(model.mm_fc_w, cur), model.mm_fc_b);
+    cb(cur, "projected", -1);
+
+    ggml_build_forward_expand(gf, cur);
+
+    return gf;
+}
+
+// indices of the k largest of v[0, n), ties to the lower index
+static std::vector<int> spk_topk(const float * v, int n, int k) {
+    std::vector<int> idx(n);
+    std::iota(idx.begin(), idx.end(), 0);
+    k = std::clamp(k, 0, n);
+    std::partial_sort(idx.begin(), idx.begin() + k, idx.end(), [&](int a, int b) {
+        return v[a] > v[b] || (v[a] == v[b] && a < b);
+    });
+    idx.resize(k);
+    return idx;
+}
+
+// NeMo SortformerModules._compress_spkcache: keep the SPK_CACHE_LEN highest-scoring rows, speaker by speaker
+static void spk_compress_cache(std::vector<float> & emb, std::vector<float> & preds, int n, int d, int n_spk,
+                               const std::vector<float> & sil_emb) {
+    const int   per_spk  = std::max(0, SPK_CACHE_LEN / n_spk - SPK_SIL_FRAMES);
+    const int   strong   = (int) std::floor(per_spk * SPK_STRONG_BOOST_RATE);
+    const int   weak     = (int) std::floor(per_spk * SPK_WEAK_BOOST_RATE);
+    const int   min_pos  = (int) std::floor(per_spk * SPK_MIN_POS_RATE);
+    const float disabled = 0.0f;
+    const float latest   = std::exp(SPK_BOOST_LATEST);
+
+    // speaker-major: each speaker's n rows, then its silence rows (+inf)
+    const int nt = n + SPK_SIL_FRAMES;
+    std::vector<float> scores((size_t) n_spk * nt, std::numeric_limits<float>::infinity());
+    for (int s = 0; s < n_spk; s++) {
+        float * sc = scores.data() + (size_t) s * nt;
+        int n_pos = 0;
+        for (int t = 0; t < n; t++) {
+            const float * pt = preds.data() + (size_t) t * n_spk;
+            float prod = 1.0f;
+            for (int j = 0; j < n_spk; j++) {
+                if (j != s) {
+                    prod *= std::max(1.0f - pt[j], SPK_PRED_SCORE_THR);
+                }
+            }
+            prod *= std::max(pt[s], SPK_PRED_SCORE_THR);
+            sc[t] = pt[s] > SPK_SPEECH_THR ? prod * SPK_SCORE_OFFSET : disabled;
+            n_pos += sc[t] > 1.0f;
+        }
+        if (n_pos >= min_pos) {
+            for (int t = 0; t < n; t++) {
+                if (!(sc[t] > 1.0f)) {
+                    sc[t] = disabled;
+                }
+            }
+        }
+        for (int t = SPK_CACHE_LEN; t < n; t++) {
+            sc[t] *= latest;
+        }
+        for (int t : spk_topk(sc, n, strong)) {
+            sc[t] *= SPK_STRONG_BOOST;
+        }
+        for (int t : spk_topk(sc, n, weak)) {
+            sc[t] *= SPK_WEAK_BOOST;
+        }
+    }
+
+    std::vector<int> pick = spk_topk(scores.data(), (int) scores.size(), SPK_CACHE_LEN);
+    const int placeholder = (int) scores.size();
+    for (int & i : pick) {
+        if (scores[i] == disabled) {
+            i = placeholder;
+        }
+    }
+    std::sort(pick.begin(), pick.end());
+
+    std::vector<float> out_emb((size_t) SPK_CACHE_LEN * d);
+    std::vector<float> out_preds((size_t) SPK_CACHE_LEN * n_spk, 0.0f);
+    for (int i = 0; i < SPK_CACHE_LEN; i++) {
+        const int t = pick[i] == placeholder ? -1 : pick[i] % nt;
+        float * e = out_emb.data() + (size_t) i * d;
+        if (t < 0 || t >= n) {
+            std::copy(sil_emb.begin(), sil_emb.end(), e);
+        } else {
+            std::copy_n(emb.data() + (size_t) t * d, d, e);
+            std::copy_n(preds.data() + (size_t) t * n_spk, n_spk, out_preds.data() + (size_t) i * n_spk);
+        }
+    }
+    emb.swap(out_emb);
+    preds.swap(out_preds);
+}
+
+// speaker cache, with its predictions, and FIFO of one recording
+struct spk_stream {
+    std::vector<float> cache, cache_preds;
+    std::vector<float> fifo;
+};
+
+// every update has a full window, which overflows the FIFO and the cache (NeMo's update period of 300 never applies)
+static_assert(mtmd_graph_nemotron_transcribe::window_core - SPK_FIFO_LEN > SPK_CACHE_LEN);
+
+// NeMo SortformerModules.streaming_update: core rows join the FIFO, its overflow moves to the cache, which is compressed
+static void update_spk_state(spk_stream & ss, const mtmd_subctx_enc_state & st, const mtmd_model & model, int64_t core_begin,
+                             int64_t n_core) {
+    const int64_t d       = model.hparams.spk_n_embd;
+    const int64_t n_spk   = model.spk_head_fc2_w->ne[1];
+    const int64_t n_cache = (int64_t) ss.cache.size() / d;
+    const int64_t n_fifo  = (int64_t) ss.fifo.size()  / d;
+    const int64_t n_rows  = (int64_t) st.spk_chunk.size() / d;
+    GGML_ASSERT((n_cache + n_fifo + n_rows) * n_spk == (int64_t) st.spk_preds.size() && core_begin + n_core <= n_rows);
+    const float * preds      = st.spk_preds.data();
+    const float * core_preds = preds + (n_cache + n_fifo + core_begin) * n_spk;
+
+    std::vector<float> fifo_preds(preds + n_cache * n_spk, preds + (n_cache + n_fifo) * n_spk);
+    ss.fifo.insert(ss.fifo.end(), st.spk_chunk.begin() + core_begin * d, st.spk_chunk.begin() + (core_begin + n_core) * d);
+    fifo_preds.insert(fifo_preds.end(), core_preds, core_preds + n_core * n_spk);
+
+    const int64_t n_pop = n_fifo + n_core - SPK_FIFO_LEN;
+    ss.cache.insert(ss.cache.end(), ss.fifo.begin(), ss.fifo.begin() + n_pop * d);
+    ss.cache_preds.insert(ss.cache_preds.end(), fifo_preds.begin(), fifo_preds.begin() + n_pop * n_spk);
+    ss.fifo.erase(ss.fifo.begin(), ss.fifo.begin() + n_pop * d);
+    spk_compress_cache(ss.cache, ss.cache_preds, (int) (ss.cache.size() / d), (int) d, (int) n_spk, model.spk_sil_emb);
+}
+
+// NeMo ParallelExpertEncoder._forward_online: windows with left/right context, one graph each, the speaker state carried
+bool mtmd_graph_nemotron_transcribe::encode_windows(mtmd_subcontext * ctx, const mtmd_model & model, mtmd_subctx_encode_params * params) {
+    GGML_ASSERT(params->imgs->entries.size() == 1 && params->out_embd != nullptr);
+    const mtmd_image_f32 & rec = params->imgs->entries[0];
+    const auto &  buf      = rec.get_ro_buf();
+    const int64_t n_frames = rec.nx();
+    const int64_t n_rows   = rec.ny();
+    const int64_t n_embd   = ctx->model.n_mmproj_embd();
+    const int     sub      = model.hparams.subsampling_factor;
+    const int64_t core     = (int64_t) window_core  * sub;
+    const int64_t left     = (int64_t) window_left  * sub;
+    const int64_t right    = (int64_t) window_right * sub;
+    const int64_t n_win    = std::max<int64_t>(1, (n_frames + core - 1) / core);
+    GGML_ASSERT((int64_t) buf.size() == n_frames * n_rows);
+
+    auto & out = *params->out_embd;
+    GGML_ASSERT(out.size() == (size_t) n_embd * ctx->model.n_output_tokens(&rec));
+
+    // the ASR expert's input: per-feature normalization over the whole recording (NeMo normalize_batch, per_feature)
+    std::vector<double> mean(n_rows), denom(n_rows);
+    for (int64_t r = 0; r < n_rows; r++) {
+        const float * row = buf.data() + r * n_frames;
+        double sum = 0.0;
+        double sq_diff_sum = 0.0;
+        for (int64_t t = 0; t < n_frames; t++) {
+            sum += (double) row[t];
+        }
+        mean[r] = sum / n_frames;
+        for (int64_t t = 0; t < n_frames; t++) {
+            const double diff = (double) row[t] - mean[r];
+            sq_diff_sum += diff * diff;
+        }
+        denom[r] = std::sqrt(sq_diff_sum / (n_frames - 1.0)) + 1e-5;
+    }
+
+    spk_stream     ss;
+    mtmd_subctx_enc_state st;
+    size_t n_out = 0;
+    for (int64_t w = 0; w < n_win; w++) {
+        const int64_t core_begin = w * core;
+        const int64_t core_end   = std::min(core_begin + core, n_frames);
+        const int64_t win_begin  = std::max<int64_t>(core_begin - left, 0);
+        const int64_t win_end    = std::min(core_end + right, n_frames);
+        const int64_t win_len    = win_end - win_begin;
+
+        std::vector<float> data((size_t) win_len * n_rows);
+        st.mel_norm.resize(data.size());
+        for (int64_t r = 0; r < n_rows; r++) {
+            const float * src = buf.data() + r * n_frames + win_begin;
+            std::copy_n(src, win_len, data.data() + r * win_len);
+            for (int64_t t = 0; t < win_len; t++) {
+                st.mel_norm[r * win_len + t] = (float) ((src[t] - mean[r]) / denom[r]);
+            }
+        }
+        mtmd_image_f32_batch batch;
+        batch.is_audio = true;
+        batch.entries.emplace_back();
+        batch.entries[0].set_size({(int) win_len, (int) n_rows}, false, true);
+        batch.entries[0].cpy_buf(data);
+
+        std::vector<float> embd((size_t) n_embd * ctx->model.n_output_tokens(&batch.entries[0]));
+        mtmd_subctx_encode_params wp = *params;
+        wp.imgs      = &batch;
+        wp.out_embd  = &embd;
+        wp.enc_state = &st;
+        if (!ctx->encode(&wp)) {
+            return false;
+        }
+
+        // output frames of the core, rounded up as NeMo's _asr_output_frame_boundary
+        const int64_t n_left = (core_begin - win_begin) / sub;
+        const int64_t n_core = (core_end - core_begin + sub - 1) / sub;
+        GGML_ASSERT((n_out + n_core) * n_embd <= out.size());
+        std::copy_n(embd.data() + n_left * n_embd, n_core * n_embd, out.data() + n_out * n_embd);
+        n_out += n_core;
+
+        if (w + 1 < n_win) {
+            update_spk_state(ss, st, model, n_left, n_core);
+            st.spk_prev = ss.cache;
+            st.spk_prev.insert(st.spk_prev.end(), ss.fifo.begin(), ss.fifo.end());
+        }
+    }
+    GGML_ASSERT(n_out * n_embd == out.size());
+    return true;
+}
