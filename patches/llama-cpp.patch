-static std::string build_soprano_dynamic_grammar() {
-    return R"(root ::= CODE* STOP?
-CODE ::= "[" SOPRANO_ID "]"
-STOP ::= "[STOP]"
-SOPRANO_ID ::= [0-9] | [1-9] [0-9] | [1-9] [0-9] [0-9] | [1-7] [0-9] [0-9] [0-9]
