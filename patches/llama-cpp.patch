+            digits = d;
+        } else if (is_pow2 && d.back() != '9') {
+            // a last digit 9 is not bumped (it would carry): no power of 2, from 2^-1074 to 2^1023, needs it
+            d.back()++;
+            if (reads_back(d)) {
+                digits = d;
+            }
+        }
+    }
