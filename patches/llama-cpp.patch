+            int kh = (kk / args.KW) % args.KH;
+            int dx = kw*args.d0;
+            int dy = kh*args.d1;
+
+            // byte offset of the reduction index kk, relative to the patch origin
+            uint offk = (kk / (args.KW*args.KH))*nb12 + dy*nb11 + dx*nb10;
