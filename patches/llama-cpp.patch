-struct clip_cap clip_get_cap(const char * fname) {
-    clip_cap res;
-    clip_model_loader loader(fname, /* skip_tensors= */ true);
-    res.has_vision = loader.has_vision;
-    res.has_audio  = loader.has_audio;
-    return res;
-}
