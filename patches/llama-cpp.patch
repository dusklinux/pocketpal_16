diff --git a/vendor/llama.cpp/tools/mtmd/models/snake-vae.cpp b/vendor/llama.cpp/tools/mtmd/models/snake-vae.cpp
new file mode 100644
index 0000000..41bfb60
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/snake-vae.cpp
@@ -0,0 +1,64 @@
+#include "models.h"
+
+// SnakeBeta, alpha and beta folded at conversion: x + beta * sin(alpha * x)^2
+// x: [T, C], alpha/beta: [C]
+ggml_tensor * mtmd_graph_snake_vae::snake(ggml_tensor * x, const mtmd_snake_vae::snake & s) const {
+    ggml_tensor * a = ggml_reshape_2d(ctx0, s.alpha, 1, s.alpha->ne[0]);
+    ggml_tensor * b = ggml_reshape_2d(ctx0, s.beta,  1, s.beta->ne[0]);
+
+    // expand reshapes first so mul/sin/sqr/mul/add lands as consecutive nodes, letting backends fuse them
+    ggml_build_forward_expand(gf, a);
+    ggml_build_forward_expand(gf, b);
+
+    ggml_tensor * y = ggml_sqr(ctx0, ggml_sin(ctx0, ggml_mul(ctx0, x, a)));
+    return ggml_add(ctx0, x, ggml_mul(ctx0, y, b));
+}
+
+// same-length conv, stride 1; x: [T, IC], w: [K, IC, OC], returns [T, OC]
+// im2col in F32: the reference decoders run in FP32
+ggml_tensor * mtmd_graph_snake_vae::conv1d(ggml_tensor * x, ggml_tensor * w, ggml_tensor * b, int dilation) const {
+    const int pad = (int) (w->ne[0] - 1) / 2 * dilation;
+    ggml_tensor * col = ggml_im2col(ctx0, w, x, 1, 0, pad, 0, dilation, 0, false, GGML_TYPE_F32); // [1, T, IC * K]
+    ggml_tensor * y = ggml_mul_mat(ctx0,
+            ggml_reshape_2d(ctx0, col, col->ne[0], col->ne[1] * col->ne[2]),
+            ggml_reshape_2d(ctx0, w, w->ne[0] * w->ne[1], w->ne[2]));
+    if (b) {
+        y = ggml_add(ctx0, y, ggml_reshape_2d(ctx0, b, 1, b->ne[0]));
+    }
+    return y;
+}
+
+ggml_tensor * mtmd_graph_snake_vae::build_snake_vae(ggml_tensor * x, const mtmd_snake_vae & vae) const {
+    static constexpr int dilations[3] = { 1, 3, 9 };
+
+    if (vae.in_proj_w) {
+        x = conv1d(x, vae.in_proj_w, vae.in_proj_b, 1);
+    }
+    x = conv1d(x, vae.in_w, vae.in_b, 1);
+    for (size_t ib = 0; ib < vae.blocks.size(); ib++) {
+        const auto & blk = vae.blocks[ib];
+        const int stride = (int) (blk.up_w->ne[0] / 2);
+        const int pad    = (stride + 1) / 2; // ceil(stride / 2) of the reference
+        x = snake(x, blk.act);
+        {
+            // ConvTranspose1d as GEMM + col2im, same as qwen3tts; up_w: [K, OC, IC]
+            const int64_t K  = blk.up_w->ne[0];
+            const int64_t OC = blk.up_w->ne[1];
+            ggml_tensor * w2  = ggml_cont(ctx0, ggml_transpose(ctx0, ggml_reshape_2d(ctx0, blk.up_w, K * OC, blk.up_w->ne[2])));
+            ggml_tensor * col = ggml_mul_mat(ctx0, w2, ggml_cont(ctx0, ggml_transpose(ctx0, x))); // [K * OC, T]
+            x = ggml_col2im_1d(ctx0, col, stride, (int) OC, pad);
+        }
+        x = ggml_add(ctx0, x, ggml_reshape_2d(ctx0, blk.up_b, 1, blk.up_b->ne[0]));
+        for (size_t ir = 0; ir < blk.res.size(); ir++) {
+            const auto & ru = blk.res[ir];
+            ggml_tensor * h = snake(x, ru.act1);
+            h = conv1d(h, ru.conv1_w, ru.conv1_b, dilations[ir]);
+            h = snake(h, ru.act2);
+            h = conv1d(h, ru.conv2_w, ru.conv2_b, 1);
+            x = ggml_add(ctx0, x, h);
+        }
+        cb(x, "vae_block", (int) ib);
+    }
+    x = snake(x, vae.post);
+    return conv1d(x, vae.out_w, vae.out_b, 1);
+}
diff --git a/vendor/llama.cpp/tools/mtmd/models/soprano.cpp b/vendor/llama.cpp/tools/mtmd/models/soprano.cpp
new file mode 100644
index 0000000..43f34f8
--- /dev/null
+++ b/vendor/llama.cpp/tools/mtmd/models/soprano.cpp
@@ -0,0 +1,78 @@
+#include "models.h"
+#include "../mtmd-audio.h"
+
+// Soprano Vocos: normalized Qwen3 hidden states -> STFT coefficients.
+ggml_cgraph * mtmd_graph_soprano::build() {
+    const auto & v = model.vocos;
+    const int n_inp = hparams.projection_dim;
+    const int n_up = upscale * (n_frames - 1) + 1;
+    ggml_tensor * cur = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_inp, n_frames);
+    ggml_set_name(cur, "inp_feats");
+    ggml_set_input(cur);
+
+    cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    cur = ggml_interpolate(ctx0, cur, n_up, n_inp, 1, 1, GGML_SCALE_MODE_BILINEAR | GGML_SCALE_FLAG_ALIGN_CORNERS);
+    if (ggml_n_dims(v.input_w) == 3) {
+        const int k = v.input_w->ne[0];
+        cur = ggml_conv_1d(ctx0, v.input_w, cur, 1, k / 2, 1);
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+    } else {
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+        cur = build_mm(v.input_w, cur);
+    }
+    cur = ggml_add(ctx0, cur, v.input_b);
+    cur = build_norm(cur, v.norm_w, v.norm_b, NORM_TYPE_NORMAL, eps, -1);
+
+    for (size_t il = 0; il < v.blocks.size(); ++il) {
+        const auto & b = v.blocks[il];
+        const int k = b.dwconv_w->ne[0];
+        ggml_tensor * residual = cur;
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+        cur = ggml_conv_1d_dw(ctx0, b.dwconv_w, cur, 1, k / 2, 1);
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur));
+        cur = ggml_add(ctx0, cur, b.dwconv_b);
+        cur = build_norm(cur, b.norm_w, b.norm_b, NORM_TYPE_NORMAL, eps, il);
+        cur = ggml_add(ctx0, build_mm(b.pw1_w, cur), b.pw1_b);
+        cur = ggml_gelu_erf(ctx0, cur);
+        cur = ggml_add(ctx0, build_mm(b.pw2_w, cur), b.pw2_b);
+        cur = ggml_add(ctx0, residual, ggml_mul(ctx0, cur, b.gamma));
+        cb(cur, "vocos_block", il);
+    }
+    cur = build_norm(cur, v.output_norm_w, v.output_norm_b, NORM_TYPE_NORMAL, eps, -1);
+    cur = ggml_add(ctx0, build_mm(v.output_w, cur), v.output_b);
+    cb(cur, "vocos_head", -1);
+
+    // the head holds n_fft/2+1 log-magnitudes followed by n_fft/2+1 phases
+    const int n_bins = v.output_w->ne[1] / 2;
+    ggml_tensor * mag = ggml_view_2d(ctx0, cur, n_bins, n_up, cur->nb[1], 0);
+    ggml_tensor * phase = ggml_view_2d(ctx0, cur, n_bins, n_up, cur->nb[1], n_bins * sizeof(float));
+    mag = ggml_clamp(ctx0, ggml_exp(ctx0, ggml_cont(ctx0, mag)), 0.0f, 100.0f);
+    phase = ggml_cont(ctx0, phase);
+    ggml_tensor * re = ggml_mul(ctx0, mag, ggml_cos(ctx0, phase));
+    ggml_tensor * im = ggml_mul(ctx0, mag, ggml_sin(ctx0, phase));
+    re = ggml_reshape_3d(ctx0, re, 1, n_bins, n_up);
+    im = ggml_reshape_3d(ctx0, im, 1, n_bins, n_up);
+    cur = ggml_concat(ctx0, re, im, 0);
+    ggml_set_name(cur, "out_audio");
+    ggml_set_output(cur);
+    ggml_build_forward_expand(gf, cur);
+    return gf;
+}
+
+void mtmd_graph_soprano::decode_spectrum(const mtmd_model & model, const std::vector<float> & spectrum, std::vector<float> & pcm) {
+    const int n_frame_vals = model.vocos.output_w->ne[1];
+    const int n_fft = n_frame_vals - 2;
+    const int hop_length = model.hparams.audio_hop_len;
+    const size_t n_frames = spectrum.size() / n_frame_vals;
+    mtmd_audio_streaming_istft istft(n_fft, hop_length);
+    pcm.clear();
+    for (size_t i = 0; i < n_frames; ++i) {
+        auto frame = istft.process_frame(spectrum.data() + i * n_frame_vals);
+        pcm.insert(pcm.end(), frame.begin(), frame.end());
+    }
+    auto tail = istft.flush();
+    pcm.insert(pcm.end(), tail.begin(), tail.end());
+    // the shared ISTFT removes (n_fft - hop) / 2 samples, torch.istft(center=True) removes n_fft / 2
+    pcm.erase(pcm.begin(), pcm.begin() + hop_length / 2);
+    pcm.resize((n_frames - 1) * hop_length);
+}
