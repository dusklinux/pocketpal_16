+        // the acoustic stack is conditioned on the clamped pitch and energy and the hard voicing decision
+        const float cond[3] = { std::clamp(p[0], -2.0f, 1.5f), p[1] > 0.0f ? 1.0f : 0.0f, std::clamp(p[2], -4.5f, 3.0f) };
